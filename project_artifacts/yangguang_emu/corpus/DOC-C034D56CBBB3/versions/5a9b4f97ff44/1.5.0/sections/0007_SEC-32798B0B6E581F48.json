      "pdf_page": 14,
      "printed_page_label": "4",
      "block_order": 11,
      "section_id": "SEC-32798B0B6E581F48",
      "section_path": [
        "2 产品描述",
        "2.2 组网应用"
      ],
      "section_title": "2.2 组网应用",
      "block_type": "list",
      "text": "•\n数据采集器可以将采集到的设备数据，通过核心交换机传输至后台站控，例如Insight、\nSCADA。",
      "table_cells": null,
      "bbox": [
