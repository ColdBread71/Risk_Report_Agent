      "review_notes": []
    },
    {
      "block_id": "BLK-0B989AF61C1F4C01",
      "document_id": "DOC-C034D56CBBB3",
      "source_sha256": "5a9b4f97ff44c0e39b26b5dff963b60b40eede9431301fd5c6324ac9da5f1d99",
      "parser_version": "1.5.0",
      "pdf_page": 13,
      "printed_page_label": "3",
      "block_order": 13,
      "section_id": "SEC-4AFAC91941E74AFD",
      "section_path": [
        "2 产品描述",
        "2.1 功能描述"
      ],
      "section_title": "2.1 功能描述",
      "block_type": "list",
      "text": "•\n数据采集器的数据转发功能默认不可用。启用该功能前，客户需在充分知情的前\n提下进行手动授权，并通过安全加密认证接入公共网络。远程访问仅在获得客户\n授权后方可生效，且相关操作受系统访问控制策略管理。",
      "table_cells": null,
      "bbox": [
        129.366,
        455.406,
        458.541,
        493.359
      ],
      "extraction_method": "native_text",
      "needs_review": false,
      "review_notes": []
    },
    {
