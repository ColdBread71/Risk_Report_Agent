      ],
      "section_title": "2.1 功能描述",
      "block_type": "paragraph",
      "text": "数据采集器具备将收集到的数据转发综自系统、站控系统或阳光云平台的功能。",
      "table_cells": null,
      "bbox": [
        102.363,
        435.406,
        417.363,
        446.359
      ],
      "extraction_method": "native_text",
