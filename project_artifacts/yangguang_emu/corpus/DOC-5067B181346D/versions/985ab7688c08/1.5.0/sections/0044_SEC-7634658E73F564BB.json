    },
    {
      "block_id": "BLK-4952F5D5B420BAF9",
      "document_id": "DOC-5067B181346D",
      "source_sha256": "985ab7688c0888ec68a5b671d2032bb8efd112a6affc42621bcf8c208b870e8e",
      "parser_version": "1.5.0",
      "pdf_page": 44,
