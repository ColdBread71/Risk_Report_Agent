    "field_id": "functions",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器Logger5000可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "数据采集器Logger5000可通过MPLC总线方式接入阳光电源生产的具备MPLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "数据采集器Logger5000支持通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器Logger5000可对接入的逆变器进行有功功率调节和无功功率调节。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "数据采集器Logger5000可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发数据至综自系统、站控系统或阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "数据采集器Logger5000可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "数据采集器Logger5000可以接受和执行来自电网的调度指令，包括远程调度控制指令、模拟量及数字量调度控制指令。",
        "block_ids": [
          "BLK-A0E52C3C63687B7D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "数据采集器Logger5000具备将收集到的数据转发至综自系统、站控系统或阳光云平台的功能。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "数据采集器Logger5000的数据转发功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93",
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "数据采集器Logger5000可以将采集到的设备数据通过核心交换机传输至后台站控系统，例如Insight、SCADA。",
        "block_ids": [
          "BLK-153C2EE70C8A30F1",
          "BLK-182EE50E531ABD2E"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-013",
        "statement": "数据采集器Logger5000也可将采集到的设备数据直接通过4G路由器传输至阳光云。",
        "block_ids": [
          "BLK-4E0353B94569ABFF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-014",
        "statement": "数据采集器Logger5000支持设备接入功能。",
        "block_ids": [
          "BLK-E3F0927286FAE321"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-015",
        "statement": "数据采集器Logger5000支持通讯设备管理功能。",
        "block_ids": [
          "BLK-9EF37D5FB5E04397"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-016",
        "statement": "数据采集器Logger5000支持Web界面配置功能。",
        "block_ids": [
          "BLK-810917AE84EC90E0"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-017",
        "statement": "数据采集器Logger5000支持网口配置功能。",
        "block_ids": [
          "BLK-254543AB77B4B866"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-018",
        "statement": "数据采集器Logger5000支持数据转发功能。",
        "block_ids": [
          "BLK-DCE8A1FE2B86D398"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-019",
        "statement": "数据采集器Logger5000支持功率调节功能。",
        "block_ids": [
          "BLK-6838AC80DEF03AC8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-020",
        "statement": "数据采集器Logger5000可以通过嵌入式Web界面，对系统时间、网络、串口等进行设置，对协议点表进行维护。",
        "block_ids": [
          "BLK-27076CE0D8D035A4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-021",
        "statement": "数据采集器Logger5000可以对接入的设备进行集中管理，包括参数配置、固件升级等，便于现场运维。",
        "block_ids": [
          "BLK-4229FA7FE6635AED"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-022",
        "statement": "“设备列表”功能模块用于管理数据采集器所接入的设备并为其配置地址，支持自动搜索设备与添加设备。",
        "block_ids": [
          "BLK-4DA082251D2A15B4",
          "BLK-F952E9FB2BDE064C"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-023",
        "statement": "数据采集器Logger5000在IEC104服务配置中支持Server模式，即作为服务器供上位机服务器连接，进行数据和指令传输。",
        "block_ids": [
          "BLK-443237FA5FBA455D"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
    ],
    "unknowns": [
      "Logger4000是否为EMU300A实际交付配置（GAP-LOGGER4000-SCOPE明确指出其适用性待确认）",
      "远程数据转发功能是否为产品功能所必需（证据未说明其必要性，仅说明其可选性与授权依赖）",
      "阳光云平台的运营方是否为阳光电源自身（证据未明确说明云平台归属与运营主体）",
