    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "系统支持五类Web用户：普通用户、运维用户、审计用户、管理员、开发者用户。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "普通用户的默认用户名为'user'，其默认密码由用户名与设备序列号（SN）拼接而成，例如SN为'SN12345678'时，默认密码为'userSN12345678'。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "运维用户的默认用户名为'maintain'，其默认密码由用户名与设备序列号（SN）拼接而成。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "审计用户的默认用户名为'auditor'，其默认密码由用户名与设备序列号（SN）拼接而成。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "管理员的默认用户名为'administrator'，其默认密码由用户名与设备序列号（SN）拼接而成。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "开发者用户的默认用户名为'develop'，其默认密码由用户名与设备序列号（SN）拼接而成。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "操作系统用户包含root用户，其默认密码根据客户授权获取设备SN后生成动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-B69166A4A2ED2877"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "所有Web用户的密码具备有效期，有效期范围为1~90天，且可通过管理员账户自行设置。",
        "block_ids": [
          "BLK-62C710106569541C",
          "BLK-A4723AAA2B990E87"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "管理员用户具有增加用户、删除用户、修改用户、清空用户、会话管理、开发者调试开关、分配用户登录证书的操作权限。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "运维用户具有本手册默认描述的所有操作权限。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "审计用户具有对所有用户的操作日志、Syslog日志进行审计的操作权限。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "开发者用户经管理员授权后可执行设备复杂故障的定位和排除。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
