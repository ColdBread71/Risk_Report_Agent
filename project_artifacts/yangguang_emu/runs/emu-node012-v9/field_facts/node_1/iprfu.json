    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "未遵循安全说明和遗留风险可引发生命危险。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "忽视随附硬件文档中的安全说明和遗留风险会导致重伤或死亡。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "进行风险评估时应考虑遗留风险。",
        "block_ids": [
          "BLK-F4322E7C8FD3E6EB"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "对关键生产区域进行单独的人员出入控制是用户的缓解措施之一。",
        "block_ids": [
          "BLK-C65542BD825C9290"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "重要组件安装在可上锁的控制柜/控制室内是用户的缓解措施之一。",
        "block_ids": [
          "BLK-F98DE46C72A1F829"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "控制柜/控制室必须配备锁，并有监控和报警设施；不建议使用结构简单的锁（如：万能锁、三角锁、四角锁或双齿锁）。",
        "block_ids": [
          "BLK-B5B2DA70170FDE95"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "在安全删除产品之前，需参考第10章安全配置指南相关内容进行操作。",
        "block_ids": [
          "BLK-6F042AC19A0269C8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "当设备需要退役报废时，应参考10.6恢复出厂设置章节操作，并通过安全渠道销毁、删除用户安全数据，确保设备不被二次部署或非法利用。",
        "block_ids": [
          "BLK-525B9314A5FDB5CB"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "产品报废场景包括：产品达到规定的使用年限；产品由于严重损坏不具备使用条件；产品主要部件或结构损坏，达不到最低使用要求且无修复价值。",
        "block_ids": [
          "BLK-4D366B3D429D69D6",
          "BLK-9AE61B78288E5DE6",
          "BLK-D558E0F03D0C4DAC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "对于预置证书作为业务使用的场景，阳光电源不对其安全性做出承诺与保证，建议用户更换使用自己的安全证书。",
        "block_ids": [
          "BLK-B775CA8B855D40B9"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "阳光电源预置证书有效期为30年。",
        "block_ids": [
          "BLK-1F38C3E74276F886"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "当证书距离过期时间不足90天时，系统触发“即将过期”告警；当证书已过期时，系统触发“已过期”告警；告警结果记录至syslog日志。",
        "block_ids": [
          "BLK-0C005846289156C7",
          "BLK-731B6EE8DB6B37A6",
          "BLK-A1646F67D0B20DF6"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
    ],
    "unknowns": [
      "产品规定的使用年限具体数值未说明",
      "‘安全渠道’的具体定义（如物理销毁方式、加密擦除标准等）未说明",
      "‘恢复出厂设置’是否清除所有持久化安全凭证（如密钥、根证书）未明确说明",
      "证书生命周期管理责任主体（用户 vs 厂商）在非预置场景下的边界未明确",
      "‘人员出入控制’的具体技术实现（如门禁类型、权限分级、审计要求）未说明",
      "‘监控和报警设施’的类型、覆盖范围及响应机制未说明"
    ],
    "contradictions": []
  },
