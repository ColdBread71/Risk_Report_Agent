        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-018",
        "statement": "Logger5000 Web界面提供‘公钥导入’功能，位于‘系统 > 系统维护’菜单下。",
        "block_ids": [
          "BLK-5B4421727B6BF311",
          "BLK-25EC72F7D907113E",
          "BLK-35A4A8029CBCFB09"
        ],
        "is_uncertain": false,
