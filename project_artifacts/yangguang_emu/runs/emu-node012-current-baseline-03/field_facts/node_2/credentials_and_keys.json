        "attributes": {}
      },
      {
        "fact_id": "FACT-021",
        "statement": "Web用户权限划分明确：普通用户仅具监控与简单设置权限；运维用户覆盖手册默认所有操作；审计用户可审计全部操作日志与Syslog日志；管理员可增删改用户、会话管理、分配证书等；开发者用户经授权后可执行复杂故障定位与排除。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-022",
        "statement": "管理员账号具有清空用户、分配用户登录证书、会话管理等专属权限。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
