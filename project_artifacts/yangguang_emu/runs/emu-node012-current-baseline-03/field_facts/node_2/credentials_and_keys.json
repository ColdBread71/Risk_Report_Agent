    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "Web界面支持普通用户、运维用户、审计用户、管理员和开发者用户五类用户类型。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "Web用户默认用户名为：普通用户'user'、运维用户'maintain'、审计用户'auditor'、管理员'administrator'、开发者用户'develop'。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "普通用户、运维用户、审计用户、管理员的默认密码由“用户名”与“设备序列号（SN）”拼接而成；例如SN为'SN12345678'、用户名为'user'时，默认密码为'userSN12345678'。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "开发者用户的密码采用动态生成机制，需通过客户授权获取设备SN后生成对应的动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-1429A3505D4AB3AA"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "操作系统用户包含root账号，其默认密码根据客户授权获取SN生成动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-B69166A4A2ED2877"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "管理员账号可创建最多4个额外的运维账号（除默认maintain账号外）。",
        "block_ids": [
          "BLK-CE969232A195110E"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "所有Web用户密码具备有效期，有效期范围为1~90天，可通过管理员账户自行设置。",
        "block_ids": [
          "BLK-62C710106569541C",
          "BLK-A4723AAA2B990E87"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "管理员可通过Web界面删除用户以立即终止其访问权限。",
        "block_ids": [
          "BLK-DBF11A90CC31126D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "管理员可通过Web界面修改任意用户密码。",
        "block_ids": [
          "BLK-BDB4B6FD02F875A2"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "重置普通用户、运维用户、审计用户账号密码需通过管理员账号登录Web端后，在用户管理页面操作。",
        "block_ids": [
          "BLK-61275F681ECF4D1E",
          "BLK-4426BD4984D9B293",
          "BLK-929758496B500C47"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "重置管理员账号密码需在Web端点击‘忘记密码’，将校验码与设备SN号发送至SUNGROW运维，再输入SUNGROW运维返回的密钥完成重置。",
        "block_ids": [
          "BLK-292B9CD931E909F1",
          "BLK-70F40B0CCFC973A7",
          "BLK-4384E460893C3259"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "系统升级时可能需要导入升级包文件对应的公钥（.pem格式）以完成数字签名校验。",
        "block_ids": [
          "BLK-F9A4F9723511D487",
          "BLK-14719D4D62193798"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-013",
        "statement": "管理员可通过Web界面分配用户登录证书。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-014",
        "statement": "新增Web用户时，用户名需由2–16位字母、数字组成，且必须以字母开头。",
        "block_ids": [
          "BLK-81634645B7FDAF2B"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-015",
        "statement": "管理员可启用开发者调试开关。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4",
          "BLK-17E66B8FE1AEAB17"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-016",
        "statement": "管理员可设置账户保护和会话安全参数。",
        "block_ids": [
          "BLK-17E66B8FE1AEAB17"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-017",
        "statement": "Web用户登录时若出现其他用户登录提示语，需先退出其他用户登录。",
        "block_ids": [
          "BLK-87F9E7FD87F93ED5",
