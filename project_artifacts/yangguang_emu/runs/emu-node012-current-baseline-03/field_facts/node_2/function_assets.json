    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "数据采集器具备将收集到的数据转发至综自系统、站控系统或阳光云平台的功能。",
        "block_ids": [
          "BLK-DCE8A1FE2B86D398",
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器的数据转发功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93",
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93",
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器集成五路具备数据交换功能的以太网口（ETH1~ETH5），其中三路为以太网口、两路为快速调度口；北向可接入综自系统或站控系统，南向可接入三方设备。",
        "block_ids": [
          "BLK-276B765BAAD65005"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "数据采集器具备协议转换服务，包括ModbusRTU转IEC104、MQTT、ModbusTCP等。",
        "block_ids": [
          "BLK-915BE31950823B72"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "数据采集器可以接受和执行来自电网的远程调度控制指令、模拟量及数字量调度控制指令。",
        "block_ids": [
          "BLK-A0E52C3C63687B7D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "数据采集器可以对接入的逆变器进行有功功率调节和无功功率调节。",
        "block_ids": [
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "本手册中涉及的远程调度、有功功率调度和无功功率调度均代表上位机调度。",
        "block_ids": [
          "BLK-59B73DED760093DE"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "数据采集器可以通过嵌入式Web界面，对系统时间、网络、串口等进行设置，对协议点表进行维护。",
        "block_ids": [
          "BLK-27076CE0D8D035A4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "数据采集器可以对接入的设备进行集中管理，包括参数配置、固件升级等，便于现场运维。",
        "block_ids": [
          "BLK-4229FA7FE6635AED"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "数据采集器可通过RS485总线接入光伏发电系统的各种设备，对设备信息进行存储和处理，并通过规约转换来转换数据的通讯协议。",
        "block_ids": [
          "BLK-1E418B79BCDA0B57"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-013",
        "statement": "安全启动功能默认处于启用状态，用于确保系统固件与操作系统镜像的完整性与合法性，防止其被非法篡改或替换。",
        "block_ids": [
          "BLK-56710D21D4166A27",
          "BLK-11E7630FDD454CE8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-014",
        "statement": "本产品中所述安全启动仅针对数采。",
        "block_ids": [
          "BLK-696CBA8087AAE64A"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-015",
        "statement": "Logger5000依托于芯片TrustZone及OP-TEE安全OS，对上层应用提供一套在安全环境下执行的加解密及存储数据接口，实现敏感数据（包括用户密码、终端证书对应的私钥等）的加密存储与解密使用。",
        "block_ids": [
          "BLK-402F20D08666D8CF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-016",
        "statement": "若使用NTS功能，客户需导入NTS服务器证书；NTS证书从NTS服务器获取，支持PEM格式的X.509证书导入。",
        "block_ids": [
          "BLK-1294EA0594DF6992"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-017",
        "statement": "用户未导入第三方证书的情况下，服务端的HTTPS、IEC104、MODBUS证书使用默认转发证书。",
        "block_ids": [
          "BLK-DB79507AFAE893E1"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-018",
        "statement": "更新或删除HTTPS证书需要重新建立链接；如遇网页无法正常打开，请重启浏览器。",
        "block_ids": [
          "BLK-7880DE869ED955AB"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-019",
        "statement": "支持NTS对时，建议采用NTS对时以及定期更新证书。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-020",
        "statement": "恢复出厂设置功能可删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-021",
        "statement": "具备操作日志、syslog记录功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-022",
        "statement": "支持软件和固件更新。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-023",
        "statement": "管理员可通过Web界面为不同用户设置不同权限的账号，包括普通用户、运维用户、审计用户、管理员和开发者用户；各用户类型具有预定义的操作权限。",
        "block_ids": [
          "BLK-3D831B5BDD0CBD81",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-024",
        "statement": "普通用户、运维用户、审计用户、管理员的默认密码由“用户名”与“设备序列号（SN）”拼接而成；开发者用户的密码采用动态生成机制，通过客户授权获得设备SN后生成。",
        "block_ids": [
          "BLK-2663D9583766CD4D",
          "BLK-1429A3505D4AB3AA"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
    ],
    "unknowns": [
      "Logger4000是否实际交付并启用（GAP-LOGGER4000-SCOPE）",
      "阳光云平台的运营方、数据处理范围及远程方案是否为产品功能所必需",
      "NTS对时是否默认启用，或仅在导入证书后可用",
      "安全启动验证链的具体组件层级（如BootROM→BL2→OP-TEE→Linux）",
      "HTTPS/IEC104/MODBUS默认转发证书的有效期、签名算法及颁发者信息",
      "‘谨慎操作’恢复出厂设置的具体影响范围（是否清除安全存储区内容）",
      "‘定期分析安全日志’所依赖的日志存储位置、保留周期及导出方式",
      "iConfig工具是否属于产品内置组件，或仅为外部辅助工具",
