    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "产品支持安全退役，包括安全删除储存的引用、配置数据及安全移除产品。",
        "block_ids": [
          "BLK-338E6AF2AA5A36A6"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "安全删除产品前需参考第10章安全配置指南相关内容进行操作。",
        "block_ids": [
          "BLK-6F042AC19A0269C8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "设备退役报废时需执行10.6恢复出厂设置，并通过安全渠道销毁、删除用户安全数据，防止二次部署或非法利用。",
        "block_ids": [
          "BLK-525B9314A5FDB5CB"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "产品报废场景包括：达到规定的使用年限；因严重损坏不具备使用条件；主要部件或结构损坏且无修复价值。",
        "block_ids": [
          "BLK-7BB0886F0F8E6371",
          "BLK-4D366B3D429D69D6",
          "BLK-9AE61B78288E5DE6",
          "BLK-D558E0F03D0C4DAC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "阳光电源预置证书有效期为30年。",
        "block_ids": [
          "BLK-1F38C3E74276F886"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "对于预置证书作为业务使用的场景，阳光电源不对其安全性做出承诺与保证，建议用户更换使用自己的安全证书。",
        "block_ids": [
          "BLK-B775CA8B855D40B9"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "若用户使用自己的证书，则需做好证书生命周期管理，推荐使用短有效期证书。",
        "block_ids": [
          "BLK-4EC00AD997F9F3D6"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "为保证安全性，建议用户每3年更新一次证书。",
        "block_ids": [
          "BLK-A549330D551DA3ED"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "系统在用户登录成功后，对证书即将过期或已过期情况进行提示，并将结果记录至syslog日志。",
        "block_ids": [
          "BLK-0C005846289156C7"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "当证书距离过期时间不足90天时，系统触发“即将过期”告警。",
        "block_ids": [
          "BLK-731B6EE8DB6B37A6"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "当证书已过期时，系统触发“已过期”告警。",
        "block_ids": [
          "BLK-A1646F67D0B20DF6"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "进行风险评估时应考虑遗留风险。",
        "block_ids": [
          "BLK-F4322E7C8FD3E6EB"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
