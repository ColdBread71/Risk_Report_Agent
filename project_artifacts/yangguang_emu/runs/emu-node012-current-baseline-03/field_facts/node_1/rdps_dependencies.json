    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元（EMU300A）可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93",
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "启用数据采集器向阳光云平台转发数据的功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93",
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "远程访问（含阳光云通信通道）仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93",
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器具备将收集到的数据转发至综自系统、站控系统或阳光云平台的功能。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "阳光云服务配置中，中国大陆地区默认接入“中国站”，欧洲地区接入“欧洲站”，澳洲地区接入“澳洲站”，其他地区接入“国际站”。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "转发三方云服务功能默认关闭。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "启用转发三方云功能前，客户需在充分知情的前提下使用管理员账号进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "转发三方云功能仅在获得管理员账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "云服务与外网有数据交互，需确认设备网络环境安全后再开启。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "时钟源设置为“阳光云”的对时方式，前提是数据采集器与阳光云平台连接；否则该对时方式无效。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
    ],
    "unknowns": [
      "阳光云平台的运营方是否为产品制造商（阳光）自身，还是第三方云服务商？",
      "‘安全加密认证’所指的具体协议、算法或认证机制（如TLS版本、证书颁发机构、双向认证要求）未说明。",
      "‘系统访问控制策略’的具体实现方式（如RBAC模型、策略存储位置、是否支持外部身份提供者）未说明。",
      "‘路由器白名单设置’的具体参数、IP范围、端口或域名规则未说明。",
      "‘三方云服务’是否包含特定已认证平台列表（如AWS IoT Core、Azure IoT Hub），或完全由用户自定义FTP/HTTP端点？",
      "‘降级模式’是否存在（例如：当阳光云不可达时是否缓存数据并重传？是否切换至本地存储或备用云？），证据中未提及。",
      "远程数据处理（RDPS）功能是否为产品出厂标配，抑或取决于合同/BOM/现场配置？证据仅说明‘默认不可用’，但未明确其交付状态。"
    ],
    "contradictions": []
  },
