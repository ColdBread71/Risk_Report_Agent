    "field_id": "functions",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器Logger5000可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "数据采集器Logger5000可通过PLC总线方式（文档中亦称MPLC总线）接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "数据采集器Logger5000支持通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器Logger5000可对接入的逆变器进行有功功率控制和无功功率调节。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "数据采集器Logger5000可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发数据至综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "数据采集器Logger5000可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "数据采集器Logger5000可以将采集到的设备数据通过核心交换机传输至后台站控系统，例如Insight、SCADA。",
        "block_ids": [
          "BLK-153C2EE70C8A30F1",
          "BLK-182EE50E531ABD2E"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "数据采集器Logger5000也可将采集到的设备数据直接通过4G路由器传输至阳光云平台。",
        "block_ids": [
          "BLK-4E0353B94569ABFF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "能量管理单元EMU300A可以直接通过路由器与阳光云平台连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "数据采集器Logger5000的数据转发功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-013",
        "statement": "阳光云平台在北美区域禁止使用（文档中表述为‘已停止服务’或‘禁止使用’）。",
        "block_ids": [
          "BLK-536C2D01D46C74B8",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-014",
        "statement": "数据采集器Logger5000可通过嵌入式Web界面配置系统时间、网络、串口等参数，并维护协议点表。",
        "block_ids": [
          "BLK-27076CE0D8D035A4"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-015",
        "statement": "数据采集器Logger5000可通过Web界面配置数据转发服务，包括转发阳光云服务、转发GOOSE服务等。",
        "block_ids": [
          "BLK-187A22E6684426E0"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-016",
        "statement": "数据采集器Logger5000具备设备列表功能，用于管理所接入设备并为其配置地址，支持自动搜索与手动添加设备。",
        "block_ids": [
          "BLK-4DA082251D2A15B4",
          "BLK-F952E9FB2BDE064C"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-017",
        "statement": "数据采集器Logger5000可作为IEC104 Server，上位机服务器连接数据采集器进行数据和指令传输。",
        "block_ids": [
          "BLK-443237FA5FBA455D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-018",
        "statement": "数据采集器Logger5000支持Modbus TCP普通调度模式，可在通讯异常恢复后根据设置调整逆变器输出功率或执行开机操作。",
        "block_ids": [
          "BLK-D1FA60EC80F0CC91",
          "BLK-B61BF16FE8CE2194"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-019",
        "statement": "数据采集器Logger5000支持B码协议实现时间同步。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-020",
        "statement": "数据采集器Logger5000支持PTP协议，通过后台时间服务器对电站内多个数据采集器进行统一对时。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-021",
        "statement": "数据采集器Logger5000支持以阳光云为时钟源进行对时，但前提是数据采集器与阳光云平台已连接，否则该对时方式无效。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-022",
        "statement": "数据采集器Logger5000支持以MODBUS-TCP为时钟源进行对时，但前提是数据采集器与后台使用MODBUS-TCP通信规约，否则该对时方式无效。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-023",
        "statement": "数据采集器Logger5000首次使用时必须配置系统时间。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-024",
        "statement": "阳光云服务默认接入站点为中国大陆地区‘中国站’、欧洲地区‘欧洲站’、澳洲地区‘澳洲站’、其他地区‘国际站’；需对路由器白名单进行相关设置以保证数据采集器功能正常使用。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
    ],
    "unknowns": [
      "Logger4000是否实际交付或启用（GAP-LOGGER4000-SCOPE明确其适用性未确认）",
      "远程数据上传功能是否为产品功能所必需（证据未说明其必要性）",
      "阳光云平台的运营方身份（证据未说明由阳光电源运营或第三方运营）",
