    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 是能量管理单元。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 内部配置有数据采集器 Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A 可通过 RS485 总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "EMU300A 通过 Modbus 协议、PLC 电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A 可通过 PLC 总线方式接入阳光电源生产的具备 PLC 功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A 对接入的逆变器可进行有功功率控制和无功功率调节。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 可通过 IEC104、Modbus、MQTT、GOOSE 等通信协议北向转发数据至综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 可将采集到的设备数据通过核心交换机传输至后台站控，例如 Insight、SCADA。",
        "block_ids": [
          "BLK-153C2EE70C8A30F1"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 可将采集到的设备数据直接通过 4G 路由器传输至阳光云。",
        "block_ids": [
          "BLK-64FE47677390A3C6"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A 支持 RS485、以太网、MPLC 通信。",
        "block_ids": [
          "BLK-BC449CE85DB4F669"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A 支持跟踪系统、箱变测控、电表、环境监测仪等多种设备接入。",
        "block_ids": [
          "BLK-B081A00CB116A76B"
        ],
        "is_uncertain": false,
        "attributes": {}
      }
    ],
    "unknowns": [
      "EMU300A 是否支持 CT 采样属于标准内置能力，还是选配/合同依赖功能（证据[BLK-D13DD174206D8434]未说明其配置属性）",
      "Logger4000 是否为 EMU300A 实际交付配置（已知 GAP-LOGGER4000-SCOPE 明确其适用性待确认）",
      "‘MPLC’是否为笔误或专有缩写（证据中未定义该术语）",
      "IEC104、Modbus、MQTT、GOOSE 等北向协议是否全部默认启用，或部分取决于合同/BOM/现场配置",
      "4G 路由器是否为 EMU300A 内置组件，或仅为外部连接选项",
      "‘阳光云平台’的运营方是否为阳光电源，或存在第三方托管情形",
      "北向远程调度指令的来源系统（如调度主站、集控中心）及其认证/授权机制未说明"
