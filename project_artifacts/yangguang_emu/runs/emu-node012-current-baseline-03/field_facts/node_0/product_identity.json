        "fact_id": "FACT-001",
        "statement": "产品正式名称为能量管理单元EMU300A。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "手册适用范围包括EMU300A、EMU300B和EMU300C。",
        "block_ids": [
          "BLK-C0D38E5E6048DD8D",
          "BLK-138A4F485D24EE25",
          "BLK-0759E280FCF0F797"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "本手册以标准配置的Logger5000界面为例，对其安全功能做简要介绍。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "具体开放的功能，请以技术协议或合同规定内容为准。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等南向设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A可通过PLC总线方式接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发到综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "MODBUS/IEC104/GOOSE协议默认关闭状态。",
        "block_ids": [
          "BLK-F8028F7583C31F09"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "能量管理单元通过核心交换机连接至Insight或SCADA。",
        "block_ids": [
          "BLK-EAF433E21E1F1D8F"
        ],
        "is_uncertain": false,
