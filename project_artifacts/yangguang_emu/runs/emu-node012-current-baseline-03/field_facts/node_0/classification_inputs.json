        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "启用数据采集器向阳光云平台转发数据功能前，客户需在充分知情的前提下进行手动授权。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "启用数据采集器向阳光云平台转发数据功能需通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "远程访问仅在获得客户授权后方可生效。",
