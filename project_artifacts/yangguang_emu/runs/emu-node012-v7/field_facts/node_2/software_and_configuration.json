    "field_id": "software_and_configuration",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "安全启动（Secure Boot）是一种基于逐级验证的启动链可信加载技术，用于确保系统固件与操作系统镜像的完整性与合法性，防止其被非法篡改或替换。",
        "block_ids": [
          "BLK-11E7630FDD454CE8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "在本产品中，安全启动功能默认处于启用状态。",
        "block_ids": [
          "BLK-56710D21D4166A27"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "本产品中安全启动仅针对数采。",
        "block_ids": [
          "BLK-696CBA8087AAE64A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "升级包需通过数字签名校验成功后，方可进行升级。",
        "block_ids": [
          "BLK-F050A216E1006236"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "若弹窗提示缺少公钥文件，需通过系统 > 系统维护 > 公钥导入导入升级包对应的公钥文件，再进行升级操作。",
        "block_ids": [
          "BLK-E414634044E2A2A1",
          "BLK-56AA86C794BB112B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "Web 端将弹窗提示是否确认升级，确认后数据采集器自动重启。新版本在重启后生效。",
        "block_ids": [
          "BLK-2B5B1D3A14E0510C",
          "BLK-AA1F4A66BBA10E2B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "可通过Web端升级阳光电源逆变器、数据采集器和PLC节点。",
        "block_ids": [
          "BLK-DC02C8FBAB3CFB88"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "Web端支持通过配置工具iConfig升级方式：Web端先检测数据采集器同一局域网下是否安装iConfig工具；如已安装并下载可用升级包，Web端展示与当前设备匹配的升级包。",
        "block_ids": [
          "BLK-9BE7D0EB955D7982",
          "BLK-5DC9B72C577D320F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "Web端支持通过阳光云升级方式：Web端展示阳光云上与当前设备匹配的线上升级包。",
        "block_ids": [
          "BLK-6526B1BEA655A990"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "通过远程维护登录数据采集器时，不支持通过配置工具iConfig升级方式进行升级。",
        "block_ids": [
          "BLK-B365C6DDD636B615"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "通过配置工具iConfig升级的前提条件是：已安装iConfig工具并下载相关升级包。",
        "block_ids": [
          "BLK-980C03EC9D178B03",
          "BLK-E42FAA2B91DEAFA6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "通过阳光云升级的前提条件是：已接入云服务且当前有可用升级包。",
        "block_ids": [
          "BLK-86DACA655BC61901",
          "BLK-A8F30CB0E2DE9C4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "Web端将根据升级包文件校验匹配的设备。",
        "block_ids": [
          "BLK-574076E2BF2ED611"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "MOXA EDS-408A交换机可通过Web HTTPS配置界面进行固件升级。",
        "block_ids": [
          "BLK-EBC2AAA9362F3A94"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "MOXA EDS-408A交换机固件升级过程中不得断电，升级成功后交换机会自动重启。",
        "block_ids": [
          "BLK-C065F821956D8A8F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "MOXA EDS-408A交换机升级完成后可在浏览器界面最上方看到固件版本。",
        "block_ids": [
          "BLK-DCA16E70D082FCB6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "MOXA EDS-408A交换机支持通过CLI执行save config保存配置。",
        "block_ids": [
          "BLK-63CBCE78F86EB9D5",
          "BLK-C32AC35F27DEDF1E",
          "BLK-E110AF44C67757BB"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "MOXA EDS-408A交换机支持通过Web HTTPS配置界面进行配置导入和备份。",
        "block_ids": [
          "BLK-C197FC251B6DDDDA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "MOXA EDS-408A交换机配置导入后，需重新通过console进入CLI配置界面关闭HTTPS和修改管理VLAN。",
        "block_ids": [
          "BLK-DBBF223192FF25E4",
          "BLK-DCA16E70D082FCB6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "iConfig工具的安装包及使用方法需联系阳光电源客户服务中心获取。",
        "block_ids": [
          "BLK-07A4FCE58B7628EA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-021",
        "statement": "固件升级提供关键的安全更新和性能优化，是确保设备稳定、安全和高效运行的关键措施。",
        "block_ids": [
          "BLK-DC02C8FBAB3CFB88"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-022",
        "statement": "升级完成后可查看当前版本号、目标版本号和升级时间等信息。",
        "block_ids": [
          "BLK-280C6DAB6D74A307"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-023",
        "statement": "MOXA EDS-408A交换机配置完成之后，需执行安全功能验证，确认当前配置安全，然后恢复网线的连接。",
        "block_ids": [
          "BLK-503D0552FE29ADF3"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-024",
        "statement": "MOXA EDS-408A交换机配置流程包含退出配置模式（exit）步骤。",
        "block_ids": [
          "BLK-EA11E94E6C5F40F1"
        ],
        "is_uncertain": false
      }
