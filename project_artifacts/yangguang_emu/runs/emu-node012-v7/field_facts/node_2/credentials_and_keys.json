          "BLK-17E66B8FE1AEAB17"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-022",
        "statement": "未说明是否存在协议密钥（如 TLS PSK、SSH host key、GOOSE/MMS 加密密钥）。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
