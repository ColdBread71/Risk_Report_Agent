    "field_id": "credentials_and_keys",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "Web 用户类型包括：普通用户（用户名 user）、运维用户（用户名 maintain）、审计用户（用户名 auditor）、管理员（用户名 administrator）、开发者用户（用户名 develop）。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "Web 普通用户、运维用户、审计用户、管理员的默认密码由“用户名”与“设备序列号（SN）”拼接而成；例如设备 SN 为“SN12345678”，用户名为“user”，则对应默认密码为“userSN12345678”。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "Web 开发者用户的密码采用动态生成机制，通过客户授权获得设备 SN 后生成对应的动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-1429A3505D4AB3AA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-004",
        "statement": "操作系统用户包含 root 用户，其默认密码根据客户授权获取 SN 后生成动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-B69166A4A2ED2877"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-005",
        "statement": "管理员账号可创建用户账号、重置账号密码、设置账户保护和会话安全参数、启用研发调试开关。",
        "block_ids": [
          "BLK-17E66B8FE1AEAB17"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "管理员可通过 Web 界面重置普通用户、运维用户、审计用户账号密码。",
        "block_ids": [
          "BLK-61275F681ECF4D1E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "重置 Web 普通用户、运维用户、审计用户账号密码的前提是通过管理员账号登录 Web 端。",
        "block_ids": [
          "BLK-4426BD4984D9B293"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "Web 管理员账号密码遗忘时，需将校验码与设备 SN 号发送至 SUNGROW 运维，再输入 SUNGROW 运维返回的密钥，方可重置密码。",
        "block_ids": [
          "BLK-70F40B0CCFC973A7",
          "BLK-4384E460893C3259"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-009",
        "statement": "所有 Web 用户的密码具备有效期，有效期范围为 1~90 天，可通过管理员账户自行设置。",
        "block_ids": [
          "BLK-62C710106569541C",
          "BLK-A4723AAA2B990E87"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "新增 Web 用户时，用户名需由 2–16 位字母、数字组成，且必须以字母开头。",
        "block_ids": [
          "BLK-81634645B7FDAF2B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "管理员至多可创建 4 个运维账号（除 maintain 账号外）。",
        "block_ids": [
          "BLK-CE969232A195110E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "管理员可通过登录管理员账户删除用户，立即终止该用户访问权限。",
        "block_ids": [
          "BLK-DBF11A90CC31126D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "管理员可通过登录管理员账户修改用户密码。",
        "block_ids": [
          "BLK-BDB4B6FD02F875A2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "系统升级时可能需要导入升级包文件对应的公钥（.pem 格式），以完成数字签名校验流程。",
        "block_ids": [
          "BLK-F9A4F9723511D487",
          "BLK-14719D4D62193798"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-015",
        "statement": "公钥导入功能位于 Web 界面「系统 > 系统维护 > 公钥导入」路径下。",
        "block_ids": [
          "BLK-5B4421727B6BF311",
          "BLK-25EC72F7D907113E",
          "BLK-35A4A8029CBCFB09"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "Web 普通用户登录时若出现其他用户登录提示语，需先退出其他用户登录。",
        "block_ids": [
          "BLK-87F9E7FD87F93ED5",
          "BLK-05304F306447D2C0"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "管理员账号具有分配用户登录证书的权限。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "Web 用户列表中未提及外部目录账号（如 LDAP/AD）集成能力，亦未说明支持外部身份源凭据。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "未说明存在独立的远程维护访问链接、令牌或专用远程维护账号。",
        "block_ids": [
          "BLK-70F40B0CCFC973A7",
          "BLK-4384E460893C3259"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "未说明设备标识（如 MAC 地址、UUID）是否作为独立凭据要素用于认证或绑定。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D",
          "BLK-B69166A4A2ED2877"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-021",
        "statement": "未说明是否存在日志导出密码或备份导出密码。",
        "block_ids": [
