    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元（EMU300A）可通过路由器连接至阳光云平台。",
        "block_ids": [
          "BLK-853407424F1C1351",
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器（Logger5000）具备将收集到的数据转发至阳光云平台的功能。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用；启用前需客户手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93",
          "BLK-E8D208159F329BFA",
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "能量管理单元可通过4G路由器将设备数据直接传输至阳光云平台。",
        "block_ids": [
          "BLK-64FE47677390A3C6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "阳光云平台服务站点按地域划分：中国大陆地区接入“中国站”，欧洲地区接入“欧洲站”，澳洲地区接入“澳洲站”，其他地区接入“国际站”。",
        "block_ids": [
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "数据采集器支持Syslog日志上传至远程服务器，需配置Syslog服务IP地址。",
        "block_ids": [
          "BLK-A3BA38611AC0C157"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "远程维护功能默认关闭；启用前需使用administrator账号进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-E8D208159F329BFA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "远程维护开关状态为“禁止”时，不可对数据采集器进行远程维护。",
        "block_ids": [
          "BLK-9A20096B42235E21"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "数据采集器支持配置时钟源为“阳光云”，但该对时方式仅在数据采集器与阳光云平台连接的前提下有效。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-012",
        "statement": "转发三方云服务功能默认关闭；启用前需使用管理员账号进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "转发三方云服务功能启用后，允许设备数据上传到配置的服务器。",
        "block_ids": [
          "BLK-8C65146392F8991F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "接入阳光云功能需以administrator身份登录后，在通信设置模块中开启通信总开关。",
        "block_ids": [
          "BLK-95BE5E587B8C4342",
          "BLK-246DEBE9E6F8F66F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "接入三方云功能需以administrator身份登录后，在通信设置 > 三方云子页面中开启三方云开关并确认授权。",
        "block_ids": [
          "BLK-84E2F121165CC7A2",
          "BLK-8C65146392F8991F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "阳光云服务与外网有数据交互，开启前需确认设备网络环境安全。",
        "block_ids": [
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-017",
        "statement": "转发三方云服务与外网有数据交互，开启前需确认设备网络环境安全。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-018",
        "statement": "数据采集器支持协议转换服务，包括ModbusRTU转IEC104、MQTT、ModbusTCP等。",
        "block_ids": [
          "BLK-915BE31950823B72"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "数据采集器可将数据转发至综自系统、站控系统或阳光云平台。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "为保证数据采集器功能正常使用，需对路由器白名单进行相关设置；参考参数请见路由器白名单设置。",
        "block_ids": [
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": true
      }
    ],
