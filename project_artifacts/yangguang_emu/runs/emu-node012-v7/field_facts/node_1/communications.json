      {
        "fact_id": "FACT-014",
        "statement": "PC作为源设备，通过Debug口（RS232协议）向EMU300A目的设备发起串口访问Linux，认证方式为用户名/密码，加密方式为无。",
        "block_ids": [
          "BLK-5751A158B27985D4"
        ],
