      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-7DF8897D9BB9225B",
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A内含开关电源。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A内含防雷模块。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "EMU300A内含微型断路器。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A内含MPLC（可选1或2）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A内含PID&ISO控制盒（可选）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A内含光纤交换机（可选）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A内含光纤终端盒（可选）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A内含IO模组（可选）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A内部结构中包含Logger5000。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A内部结构中包含光纤环网交换机，该组件为选配，且必须与光纤终端盒配套使用。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A内部结构中包含PID模块，支持PID防护和PID修复功能，适用于PV-正偏置组件，支持交流ISO检测功能。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "EMU300A内部结构中包含PLC模块。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "EMU300A内部结构中包含220V市电插座，可为现场运维人员提供市电。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "EMU300A内部结构中包含风扇。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "Logger5000集成五路具备数据交换功能的以太网口（即ETH1~ETH5），三路以太网口，两路快速调度口。",
        "block_ids": [
          "BLK-276B765BAAD65005"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "Logger5000支持通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等。",
        "block_ids": [
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "Logger5000支持通过MPLC总线方式接入阳光电源生产的具备MPLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "Logger5000的数据转发功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "路由器和防火墙不在供货范围内，由客户自行购买。",
        "block_ids": [
          "BLK-10A8D5FE01AF321E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-021",
        "statement": "RS485通讯端子未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-022",
        "statement": "交流熔丝盒未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-023",
