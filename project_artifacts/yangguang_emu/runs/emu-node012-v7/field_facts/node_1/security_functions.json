      },
      {
        "fact_id": "FACT-003",
        "statement": "支持用户增删改功能以及密码安全策略配置。",
        "block_ids": [
          "BLK-063FA03B0275437B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "支持北向MODBUS/IEC104/GOOSE等协议配置管理。",
        "block_ids": [
          "BLK-063FA03B0275437B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "支持PKI颁发的证书管理。",
        "block_ids": [
          "BLK-063FA03B0275437B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "安全启动功能默认开启，建立启动链可信验证，阻断非签名或篡改后的软件加载执行。",
        "block_ids": [
          "BLK-864B9073B04B55EA",
          "BLK-56710D21D4166A27"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "安全启动功能仅针对数采。",
        "block_ids": [
          "BLK-696CBA8087AAE64A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "Logger5000依托于芯片TrustZone及OP-TEE安全OS，对上层应用提供在安全环境下执行的加解密及存储数据接口。",
        "block_ids": [
          "BLK-402F20D08666D8CF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "Logger5000在安全环境下实现敏感数据加密存储、解密使用，包括用户密码、终端证书对应的私钥等数据。",
        "block_ids": [
          "BLK-402F20D08666D8CF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "支持HTTPS/北向IEC104/MODBUS等协议TLS加密通信。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "支持NTS对时。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "支持恢复出厂设置功能，删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "支持操作日志、syslog记录功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "支持软件和固件更新。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "通过系统 > 证书管理 > 采集/转发/NTS对时证书，支持导入证书。",
        "block_ids": [
          "BLK-76BE0FA03440A031"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "设备出厂自带默认PKI颁发的证书，建议导入客户的签名证书。",
        "block_ids": [
          "BLK-36828A2B13F690DE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "若使用NTS功能，客户需导入NTS服务器证书；NTS证书从NTS服务器获取，支持PEM格式的X.509证书导入。",
        "block_ids": [
          "BLK-1294EA0594DF6992"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "当证书距离过期时间不足90天时，系统触发“即将过期”告警。",
        "block_ids": [
          "BLK-731B6EE8DB6B37A6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "用户登录成功后，对于证书即将过期或已过期，系统将提示，并将结果记录至syslog日志。",
        "block_ids": [
          "BLK-0C005846289156C7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "在系统 > 转发配置页面，点击goose，可勾选防重放开关；用户可根据需要自行设置检测时间参数。",
        "block_ids": [
          "BLK-562EB901BC002DDD"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-021",
        "statement": "在系统 > 证书管理页面，点击goose密钥，选择密钥导入，上传密钥文件即可完成密钥更新。",
        "block_ids": [
          "BLK-90A3EAF30CD1A413"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-022",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络；远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-023",
        "statement": "远程维护功能默认关闭；启用该功能前，客户需在充分知情的前提下使用administrator账号进行手动授权，并通过安全加密认证接入公共网络；远程访问仅在获得administrator账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-E8D208159F329BFA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-024",
        "statement": "阳光云平台在北美区域禁止使用。",
