    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "产品退役场景包括：产品达到规定的使用年限；产品由于严重损坏，不具备使用条件；产品主要部件或结构损坏，达不到最低使用要求，又无修复价值。",
        "block_ids": [
          "BLK-7BB0886F0F8E6371",
          "BLK-4D366B3D429D69D6",
          "BLK-9AE61B78288E5DE6",
          "BLK-D558E0F03D0C4DAC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "当设备需要退役报废时，应参考10.6 恢复出厂设置章节操作，并通过安全的渠道销毁，删除用户安全数据，确保设备不被二次部署到用户的运营系统或被非法利用。",
        "block_ids": [
          "BLK-525B9314A5FDB5CB"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "在安全删除产品之前，应参考10 安全配置指南章节相关内容进行操作。",
        "block_ids": [
          "BLK-6F042AC19A0269C8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "阳光电源预置证书有效期为30年。",
        "block_ids": [
          "BLK-1F38C3E74276F886"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "对于预置证书作为业务使用的场景，阳光电源不对其安全性做出承诺与保证，建议用户更换使用自己的安全证书。",
        "block_ids": [
          "BLK-B775CA8B855D40B9"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "如果用户使用自己的证书，则需做好对证书生命周期的管理，为保证安全性推荐使用短有效期的证书。",
        "block_ids": [
          "BLK-4EC00AD997F9F3D6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "为保证安全性，建议用户每3年更新一次证书。",
        "block_ids": [
          "BLK-A549330D551DA3ED"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "当证书距离过期时间不足90天时，系统触发“即将过期”告警。",
        "block_ids": [
          "BLK-731B6EE8DB6B37A6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "当证书已过期时，系统触发“已过期”告警。",
        "block_ids": [
          "BLK-A1646F67D0B20DF6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "用户登录成功后，对于证书即将过期或已过期，系统将提示，并将结果记录至syslog日志。",
        "block_ids": [
          "BLK-0C005846289156C7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "进行风险评估时应考虑遗留风险。",
        "block_ids": [
          "BLK-F4322E7C8FD3E6EB"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "忽视随附硬件文档中的安全说明和遗留风险会导致重伤或死亡。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false
      }
    ],
