    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "系统支持五类Web用户：普通用户、运维用户、审计用户、管理员、开发者用户。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "普通用户的用户名为“user”，默认密码由“用户名”与“设备序列号（SN）”拼接而成，例如设备SN为“SN12345678”时，默认密码为“userSN12345678”。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "运维用户的用户名为“maintain”，默认密码由“用户名”与“设备序列号（SN）”拼接而成。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "审计用户的用户名为“auditor”，默认密码由“用户名”与“设备序列号（SN）”拼接而成。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "管理员的用户名为“administrator”，默认密码由“用户名”与“设备序列号（SN）”拼接而成。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "开发者用户的用户名为“develop”，默认密码由“用户名”与“设备序列号（SN）”拼接而成。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "普通用户仅有系统的监控权限和简单的设置权限，如概览、设备监控和部分历史数据的查看。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "运维用户具有本手册默认描述的所有操作权限。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "审计用户可对所有用户的操作日志、Syslog日志进行审计。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "管理员可执行增加用户、删除用户、修改用户、清空用户、会话管理、开发者调试开关、分配用户登录证书。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "开发者用户经管理员授权后可执行设备复杂故障的定位和排除。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "所有用户的密码都具备有效期，密码有效期范围为1~90天，可通过管理员账户自行设置。",
        "block_ids": [
          "BLK-62C710106569541C",
          "BLK-A4723AAA2B990E87"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "操作系统用户root的默认密码生成机制是否与Web用户一致（证据仅说明其密码‘根据客户授权获取SN生成动态密码’，未明确是否同样采用‘用户名+SN’拼接）",
      "开发者用户是否属于标准交付配置，或仅在合同/现场配置启用（证据未说明其部署状态，仅描述权限）",
      "是否存在其他非Web用户类型（如CLI用户、API调用主体等），证据未覆盖",
      "各用户类型是否支持多实例并发登录，或存在会话数限制（证据仅提及‘当普通用户登录时出现其他用户登录提示语时，需要先退出其他用户登录’，未定义会话策略）",
      "管理员权限是否包含对用户角色定义的自定义能力（如新增角色、修改权限矩阵），证据仅列出预置角色及对应权限"
    ],
