    "field_id": "operational_environment",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "工业网络安全的核心目标包括可用性：确保系统、网络和数据在需要时可被授权用户访问和使用，防止因破坏、故障或拒绝服务攻击(DoS)导致的业务中断。",
        "block_ids": [
          "BLK-32D86711ED1302DA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "工业网络安全的核心目标包括保密性：防止敏感数据、配置信息和网络资源等遭到非法访问、窃取或泄露。",
        "block_ids": [
          "BLK-D29A82FAFD09D484"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "工业网络安全保护目标之一是确保生产设备和流程的无故障运行和可用性。",
        "block_ids": [
          "BLK-F30391C2A61969FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "工业网络安全保护目标之一是防范网络攻击危及人员安全与生产安全。",
        "block_ids": [
          "BLK-D91D8C5D38EFEB46"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "工业网络安全保护目标之一是防止机密数据遭受未经授权的访问。",
        "block_ids": [
          "BLK-5D9BB1795ED1309B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "在实施安全措施时，需确保这些措施不会反感或者危及自动化系统以及组件的可操作性。",
        "block_ids": [
          "BLK-2BC99C167CF3B5F3"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "企业物理安全存在漏洞时，未经授权的人员可能进入生产环境，损坏或修改生产设备，导致机密信息丢失；因此必须采取适当措施保护公司所在地和关键生产区域。",
        "block_ids": [
          "BLK-AF5815D0F7E277A5",
          "BLK-BDEC2C4D8C8E8B36"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "网络安全包括对所有接口的安全审查，并应进行网络隔离；最简单的情况是通过一个防火墙实现隔离，该防火墙可以控制和检查不同网络之间的通信。",
        "block_ids": [
          "BLK-F15FEACD7EBFF705",
          "BLK-A6E3C93078316D21"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "建议部署防恶意代码设备。",
        "block_ids": [
          "BLK-9F5E44DC2AD36DE5"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-010",
        "statement": "产品北向属于安全重点关注区域，用户网络环境应在北向数据出口部署防火墙、防恶意代码设备、IDS等安全设备，构建安全的北向安全网络。",
        "block_ids": [
          "BLK-B6469A1F85E312C7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "产品南向属于近端网络部署，网络环境相对安全但并非绝对安全；建议南向和北向网络使用独立的交换机进行部署，实现网络隔离。",
        "block_ids": [
          "BLK-AFA75AA365265142",
          "BLK-AFED3332E2924093"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "南向设备对本产品来说属于三方设备，是否会对网络安全造成威胁由用户来保障。",
        "block_ids": [
          "BLK-EB131CDE5EBDAAA4"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Web端运行环境是否要求特定操作系统、浏览器版本或硬件配置（证据仅说明语言支持，未提及其他运行环境约束）",
      "北向/南向网络的具体拓扑结构、IP地址规划、VLAN划分或物理链路类型（证据未描述）",
      "防火墙、防恶意代码设备、IDS等安全设备的部署方式是否为产品强制要求或仅属建议（'应'与'建议'混用，未明确强制性）",
      "Logger4000是否实际部署于本 operational environment（GAP-LOGGER4000-SCOPE 明确其适用性待确认）",
      "远程升级、云平台、数据上传等能力是否存在于本 operational environment（证据未提及）"
    ],
    "contradictions": []
  },
