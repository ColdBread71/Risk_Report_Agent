    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元（EMU300A）可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "启用数据采集器向阳光云平台转发数据的功能前，客户需在充分知情的前提下进行手动授权。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "启用数据采集器向阳光云平台转发数据的功能需通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "远程访问仅在获得客户授权后方可生效。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "远程访问相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 的安全功能构成其纵深防御体系，在产品定义的安全上下文中提供对欺骗、篡改、否认、信息泄露、拒绝服务等威胁的保护。",
        "block_ids": [
          "BLK-916567FFECD7233D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 的工业网络安全目标包括可用性、保密性和完整性。",
        "block_ids": [
          "BLK-09BB4F761E6C697C",
          "BLK-32D86711ED1302DA",
          "BLK-D29A82FAFD09D484",
          "BLK-14EB48F1B4784375"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 支持 HTTPS、北向 IEC104、MODBUS 等协议的 TLS 加密通信。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 支持 NTS 对时。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A 具备恢复出厂设置功能，可删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A 具备操作日志和 syslog 记录功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "未明确说明阳光云平台的运营方是否为阳光公司或第三方。",
      "未明确说明远程连接能力是否为产品功能所必需（即：若不启用云连接，EMU300A 是否仍满足基本功能定义）。",
      "未明确说明‘数据采集器’具体指代哪个组件（如：Logger5000 或其他内置/外置单元）；GAP-LOGGER4000-SCOPE 明确指出 Logger4000 适用性待确认，且 Logger5000 被标识为标准内部采集器，但本字段证据未直接命名该采集器。",
      "未明确说明 TLS 加密通信是否为默认启用或需客户配置启用。",
      "未明确说明 NTS 对时是否需客户配置启用或证书管理责任归属。",
      "未明确说明操作日志和 syslog 的存储位置、保留周期及远程传输能力。",
      "未明确说明软件和固件更新是否支持远程自动升级，或仅支持本地手动升级。"
    ],
    "contradictions": []
  },
