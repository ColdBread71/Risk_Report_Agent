    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 能量管理单元可通过4G路由器将采集到的设备数据直接传输至阳光云。",
        "block_ids": [
          "BLK-58481F3BF8C8F982"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 通过核心交换机连接至后台站控。",
        "block_ids": [
          "BLK-88F7F2D2F44E6545"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A 通过核心交换机连接至Insight或SCADA。",
        "block_ids": [
          "BLK-202781F4D7F5C1D3"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "当采用环形组网方式时，一个环网中最多可接入15台EMU300A。",
        "block_ids": [
          "BLK-A117B2CB2E7B47A8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A 支持RS485、以太网、MPLC通信。",
        "block_ids": [
          "BLK-BC449CE85DB4F669"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A 支持跟踪系统、箱变测控、电表、环境监测仪等多种设备接入。",
        "block_ids": [
          "BLK-B081A00CB116A76B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "光纤终端盒为选配，必须与光纤环网交换机配套使用。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "RS485通讯端子线缆未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "交流熔丝盒线缆未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "接地端子线缆未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "光纤环网交换机为选配，必须与光纤终端盒配套使用。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A内含Logger5000（含电压电流采样接口）、开关电源、防雷模块、微型断路器、MPLC（可选1或2）、PID&ISO控制盒（可选）、光纤交换机（可选）、光纤终端盒（可选）、IO模组（可选）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true
      }
    ],
    "unknowns": [
      "Logger4000是否属于EMU300A交付配置范围（GAP-LOGGER4000-SCOPE明确其适用性需客户/配置确认）",
      "环形组网与星形组网是否互斥，或是否可同时部署（图2-1与图2-2未说明部署约束关系）",
      "ETH1/2/5以太网口与ETH3/4快速调度口在物理结构上是否分属不同硬件模块或逻辑隔离域",
      "MPLC通信接口个数可选（1或2）的具体合同/订单依赖依据未提供",
      "PID&ISO控制盒、光纤交换机、光纤终端盒、IO模组等可选模块的默认供货状态（标准BOM是否含基础配置）未明确",
      "南向网络中‘三方设备’的具体边界定义（是否包含所有RS485/MPLC接入设备，或仅限特定协议设备）",
      "‘南向和北向网络使用独立交换机进行部署’是安全建议还是强制设计要求",
      "阳光云的运营方、数据主权归属及远程服务是否为产品功能所必需（GAP-CONTRACT-VARIANTS与GAP-RDPS未覆盖）"
    ],
