    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元可以将采集到的设备数据，通过核心交换机传输至后台站控，例如Insight、SCADA。",
        "block_ids": [
          "BLK-7FA29D70D79F1001",
          "BLK-153C2EE70C8A30F1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "能量管理单元也可将采集到的设备数据，直接通过4G路由器传输至阳光云。",
        "block_ids": [
          "BLK-58481F3BF8C8F982",
          "BLK-64FE47677390A3C6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "能量管理单元可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "启用数据采集器将数据转发至阳光云平台的功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "能量管理单元可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发到综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "能量管理单元可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "若设备遭受攻击导致无法恢复正常运行，可联系阳光电源运维人员通过SD卡重新烧制系统进行恢复。",
        "block_ids": [
          "BLK-FAE24332B330471F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "能量管理单元通过核心交换机连接至Insight或SCADA的方式在文档中以图示说明。",
        "block_ids": [
          "BLK-EAF433E21E1F1D8F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "安全功能包括软件和固件更新，建议关注产品相关安全公告，及时升级到最新版本。",
        "block_ids": [
          "BLK-26A4B8B218CB053B",
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "远程服务是否为产品功能所必需",
      "阳光云平台的运营方是否为阳光电源",
      "阳光云平台的数据处理责任方是否为阳光电源",
      "远程升级功能是否依赖阳光云平台",
