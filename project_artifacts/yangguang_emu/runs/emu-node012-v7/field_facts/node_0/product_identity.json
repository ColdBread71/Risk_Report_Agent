    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "产品正式名称为能量管理单元EMU300A。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "手册适用范围包括 EMU300A、EMU300B 和 EMU300C。",
        "block_ids": [
          "BLK-C0D38E5E6048DD8D",
          "BLK-138A4F485D24EE25",
          "BLK-0759E280FCF0F797"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "本手册以标准配置的Logger5000界面为例介绍安全功能。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "具体开放的功能请以技术协议或合同规定内容为准。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-006",
        "statement": "MODBUS/IEC104/GOOSE 协议默认关闭状态。",
        "block_ids": [
          "BLK-F8028F7583C31F09"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 支持通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 可通过PLC总线方式接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发到综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A 可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A 通过核心交换机连接至Insight或SCADA。",
        "block_ids": [
          "BLK-EAF433E21E1F1D8F"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "EMU300A 的具体硬件型号（如主控板、交换机、电源模块等）未在证据中说明。",
      "EMU300A 的固件/软件版本号未在证据中明确给出（仅手册版本为Ver11-202607）。",
      "Logger5000 是否为EM300A唯一内置数据采集器，或是否存在其他可选采集器（如Logger4000）未被确认；GAP-LOGGER4000-SCOPE 明确指出Logger4000适用性待客户/配置确认。",
      "EMU300A 标准配置与选配模块的具体BOM清单未提供。",
      "‘核心交换机’的品牌、型号、固件版本及是否为EMU300A内置组件或外置设备未说明。",
      "‘阳光云平台’的运营方、部署位置（公有云/私有云/混合云）、是否为产品功能所必需未说明。",
      "‘压缩密码长度为8~32位’适用于哪个系统或组件（如Logger5000 Web界面、EMU300A本地CLI、远程管理接口等）未明确指定。"
    ],
