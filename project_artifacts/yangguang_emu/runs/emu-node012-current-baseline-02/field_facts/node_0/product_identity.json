        "statement": "产品正式名称为能量管理单元EMU300A。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 型号系列包括 EMU300A、EMU300B 和 EMU300C。",
        "block_ids": [
          "BLK-C0D38E5E6048DD8D",
          "BLK-138A4F485D24EE25",
          "BLK-0759E280FCF0F797"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A 内部标准配置的数据采集器为 Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "Logger5000 在本手册中作为标准配置界面示例使用。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A 支持通过 RS485 总线接入南向设备，如逆变器、箱变、环境监测仪、电表等。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A 支持通过 PLC 总线接入阳光电源生产的具备 PLC 功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 支持通过 IEC104、Modbus、MQTT、GOOSE 等协议北向转发数据至综自系统、站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 通过核心交换机连接至 Insight 或 SCADA 系统。",
        "block_ids": [
          "BLK-EAF433E21E1F1D8F"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "MODBUS/IEC104/GOOSE 协议在 EMU300A 上默认关闭。",
        "block_ids": [
          "BLK-F8028F7583C31F09"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
