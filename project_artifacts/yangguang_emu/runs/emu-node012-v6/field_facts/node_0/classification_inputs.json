    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 能量管理单元可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "启用数据采集器向阳光云平台转发数据功能前，客户需在充分知情的前提下进行手动授权。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "启用数据采集器向阳光云平台转发数据功能需通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "远程访问仅在获得客户授权后方可生效。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "远程访问相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 的安全功能作为一个整体构成其纵深防御体系。",
        "block_ids": [
          "BLK-916567FFECD7233D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 产品定义的安全上下文提供对欺骗、篡改、否认、信息泄露、拒绝服务等威胁的保护。",
        "block_ids": [
          "BLK-916567FFECD7233D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 支持 HTTPS/北向 IEC104/MODBUS 等协议的 TLS 加密通信。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 支持 NTS 对时。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A 具备恢复出厂设置功能，可删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A 具备操作日志、syslog 记录功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "未明确说明阳光云平台的运营方是否为阳光公司自有，或是否依赖第三方云服务商。",
      "未明确说明‘安全加密认证’的具体机制（如证书类型、密钥管理方式、认证协议）。",
      "未明确说明 TLS 加密通信是否为默认启用，或是否需客户配置启用。",
