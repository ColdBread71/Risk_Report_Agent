      {
        "fact_id": "FACT-010",
        "statement": "PID模块支持PID防护和PID修复功能，适用于PV-正偏置组件；支持交流ISO检测功能。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "MPLC通信接口数量为1或2，个数可选。",
