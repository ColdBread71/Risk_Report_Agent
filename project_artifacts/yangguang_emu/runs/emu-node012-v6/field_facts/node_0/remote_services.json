    "field_id": "remote_services",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元可以将采集到的设备数据，通过核心交换机传输至后台站控，例如Insight、SCADA。",
        "block_ids": [
          "BLK-7FA29D70D79F1001",
          "BLK-153C2EE70C8A30F1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "能量管理单元也可将采集到的设备数据，直接通过4G路由器传输至阳光云。",
        "block_ids": [
          "BLK-58481F3BF8C8F982",
          "BLK-64FE47677390A3C6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "能量管理单元可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-005",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-006",
        "statement": "能量管理单元可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发到综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "能量管理单元可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "可通过系统 > 系统维护 > 系统升级更新版本来修复已修复的安全漏洞。",
        "block_ids": [
          "BLK-3CE6028352D5908D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "通过阳光云升级：已接入云服务且当前有可用升级包。",
        "block_ids": [
          "BLK-C8CDDA0E58006FDF"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-010",
        "statement": "通过配置工具iConfig升级：已安装iConfig工具并下载相关升级包。",
        "block_ids": [
          "BLK-8D8B9543DD137576"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "如果设备遭受攻击导致无法恢复正常运行，可联系阳光电源运维人员通过SD卡重新烧制系统进行恢复。",
        "block_ids": [
          "BLK-FAE24332B330471F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "阳光电源预置证书仅用于部署阶段为设备接入客户网络建立初始安全通道，阳光电源不对预置证书的安全性做承诺与保证。",
        "block_ids": [
          "BLK-46C00A4E0F6A683B"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "远程服务（阳光云）是否为产品功能所必需；若未启用，相关产品功能是否不可用",
      "阳光云平台的运营方是否为阳光电源，或存在第三方云服务商依赖",
      "阳光云平台是否提供远程运维、远程升级、数据上传等具体能力的详细技术实现和责任边界",
      "Logger5000是否参与阳光云数据上传路径（GAP-LOGGER4000-SCOPE明确排除Logger4000，但未确认Logger5000在云路径中的角色）",
      "‘通过4G路由器传输至阳光云’是否隐含内置4G模块，或依赖外置/客户侧4G路由器（证据未说明设备是否自带4G通信能力）",
      "‘已接入云服务’在FACT-009中作为阳光云升级的前提条件，但未说明该接入是产品出厂默认配置、合同选配、还是现场手动配置"
    ],
    "contradictions": []
  },
