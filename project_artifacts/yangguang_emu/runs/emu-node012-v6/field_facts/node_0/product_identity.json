    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "产品正式名称为 EMU300A。",
        "block_ids": [
          "BLK-C0D38E5E6048DD8D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 产品内部配置有数据采集器 Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "手册适用范围包括 EMU300A、EMU300B 和 EMU300C。",
        "block_ids": [
          "BLK-C0D38E5E6048DD8D",
          "BLK-138A4F485D24EE25",
          "BLK-0759E280FCF0F797"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "本手册以标准配置的 Logger5000 界面为例介绍安全功能。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "具体开放的功能请以技术协议或合同规定内容为准。",
        "block_ids": [
          "BLK-4F06298C83E671CF"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A 可通过 RS485 总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 支持通过 Modbus 协议、PLC 电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 可通过 IEC104、Modbus、MQTT、GOOSE 等通信协议北向转发到综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "MODBUS/IEC104/GOOSE 协议默认关闭状态。",
        "block_ids": [
          "BLK-F8028F7583C31F09"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "能量管理单元通过核心交换机连接至 Insight 或 SCADA。",
        "block_ids": [
          "BLK-EAF433E21E1F1D8F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "压缩密码长度要求为 8~32 位，需由大写字母、小写字母、数字、特殊符号中的三种或以上组成。",
        "block_ids": [
          "BLK-65CA5F49250566BD"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
