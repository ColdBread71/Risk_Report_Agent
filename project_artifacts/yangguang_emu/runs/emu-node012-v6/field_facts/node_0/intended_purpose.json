    "field_id": "intended_purpose",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "EMU300A可通过PLC总线方式接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A对接入的逆变器可进行有功功率控制和无功功率调节。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发数据至综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A可以将采集到的设备数据通过核心交换机传输至后台站控，例如Insight、SCADA。",
        "block_ids": [
          "BLK-153C2EE70C8A30F1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A也可将采集到的设备数据直接通过4G路由器传输至阳光云。",
        "block_ids": [
          "BLK-64FE47677390A3C6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A支持RS485、以太网、MPLC通信。",
        "block_ids": [
          "BLK-BC449CE85DB4F669"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A支持跟踪系统、箱变测控、电表、环境监测仪等多种设备接入。",
        "block_ids": [
          "BLK-B081A00CB116A76B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A支持CT采样，以毫秒级精度采集逆变器子阵电流，实现快速功率调节。",
        "block_ids": [
          "BLK-D13DD174206D8434"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger4000是否为EMU300A实际交付配置（GAP-LOGGER4000-SCOPE明确指出其适用性需客户确认）",
      "‘MPLC’通信的具体技术定义及是否等同于PLC电力载波（文档未明确定义MPLC）",
      "‘南向设备接入’是否包含所有列出设备类型（逆变器、箱变、环境监测仪、电表）为标准支持，抑或部分依赖合同/BOM/现场配置（GAP-CONTRACT-VARIANTS要求保留不确定性）",
      "IEC104、Modbus、MQTT、GOOSE等北向协议是否全部默认启用，或部分为可选/需配置启用（证据未说明启用状态）",
      "4G路由器是否为EMU300A内置组件，或仅为外部连接选项（证据仅描述‘通过4G路由器传输’，未说明归属与集成程度）",
      "‘阳光云平台’的运营方、数据处理范围及是否为产品功能所必需的远程方案（GAP-RDPS要求明确运营方和依赖，但证据未提供）"
    ],
    "contradictions": []
  },
