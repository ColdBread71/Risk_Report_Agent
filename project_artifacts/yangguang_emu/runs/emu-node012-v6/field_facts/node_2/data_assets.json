  "result": {
    "node_id": "node_2",
    "field_id": "data_assets",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-7DF8897D9BB9225B",
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "Logger5000可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-7DF8897D9BB9225B",
          "BLK-0FE6A5150E10C5BC",
          "BLK-1E418B79BCDA0B57",
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "Logger5000可通过PLC总线方式接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-7DF8897D9BB9225B",
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "Logger5000可通过MPLC总线方式接入阳光电源生产的具备MPLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0E8FEC54AF1BFA37"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "Logger5000可将采集到的设备数据通过核心交换机传输至后台站控，例如Insight、SCADA。",
        "block_ids": [
          "BLK-7FA29D70D79F1001",
          "BLK-153C2EE70C8A30F1",
          "BLK-182EE50E531ABD2E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "Logger5000可将采集到的设备数据直接通过4G路由器传输至阳光云。",
        "block_ids": [
          "BLK-58481F3BF8C8F982",
          "BLK-64FE47677390A3C6",
          "BLK-4E0353B94569ABFF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "Logger5000具备数据转发功能，可将收集到的数据转发至综自系统、站控系统或阳光云平台。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "Logger5000的数据转发功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "Logger5000具备协议转换服务，包括ModbusRTU转IEC104、MQTT、ModbusTCP等。",
        "block_ids": [
          "BLK-915BE31950823B72"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "Logger5000可以接受和执行来自电网的远程调度控制指令、模拟量及数字量调度控制指令。",
        "block_ids": [
          "BLK-A0E52C3C63687B7D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "Logger5000可以对接入的逆变器进行有功功率调节和无功功率调节。",
        "block_ids": [
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "Logger5000可以接受和执行本地调度指令，包括固定值下发、电表闭环调度等。",
        "block_ids": [
          "BLK-9FEE6C4E83C7B395"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger5000是否实际存储/处理/缓存采集到的原始设备数据（如遥测值、日志、审计记录）的具体类型、格式、生命周期及持久化位置未明确说明。",
      "Logger5000是否生成或维护自身运行日志、审计记录、配置变更日志及其存储方式未明确说明。",
      "Logger5000是否采集并传输用户数据（如操作员身份、权限配置、调度策略参数）未明确说明。",
      "Logger5000是否对传输中的数据（如经RS485、4G、核心交换机路径）执行加密或完整性保护未明确说明。",
      "‘阳光云’平台的运营方、数据接收端责任归属、数据主权约定及是否构成RDPS未在证据中明确说明。",
      "Logger5000是否支持对上传至阳光云的数据进行脱敏、过滤或字段级选择性转发未明确说明。",
      "Logger5000是否具备本地数据存储能力（如内置Flash/SD卡）、存储容量、保留时长及擦除机制未明确说明。",
      "Logger5000是否采集并转发GOOSE报文本身（而非仅支持GOOSE协议转发配置）未明确说明；BLK-187A22E6684426E0仅提及配置入口，未确认功能启用状态。",
      "Logger4000是否在任何交付配置中作为EMU300A的数据采集组件存在，仍为待确认项（见GAP-LOGGER4000-SCOPE）。",
      "‘核心交换机’是否为EMU300A内置组件、外置第三方设备，或其通信链路是否受EMU300A安全控制未明确说明。"
    ],
    "contradictions": []
  },
