    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "数据采集器具备将收集到的数据转发综自系统、站控系统或阳光云平台的功能。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器的数据转发功能默认不可用。启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-003",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-004",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器可以接受和执行来自电网的调度指令，包括远程调度控制指令、模拟量及数字量调度控制指令。",
        "block_ids": [
          "BLK-A0E52C3C63687B7D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "数据采集器可以对接入的逆变器进行有功功率调节和无功功率调节。",
        "block_ids": [
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "“设备列表”功能模块用于管理数据采集器所接入的设备并为其配置地址。可以自动搜索设备与添加设备。",
        "block_ids": [
          "BLK-F952E9FB2BDE064C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "远程维护功能默认关闭。启用该功能前，客户需在充分知情的前提下使用administrator账号进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-E8D208159F329BFA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-009",
        "statement": "远程访问仅在获得administrator账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-E8D208159F329BFA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-010",
        "statement": "通过阳光云升级：Web端展示阳光云上与当前设备匹配的线上升级包。",
        "block_ids": [
          "BLK-6526B1BEA655A990"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "通过远程维护登录数据采集器时，不支持通过配置工具iConfig升级方式进行升级。",
        "block_ids": [
          "BLK-B365C6DDD636B615"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "以administrator身份登录后，可进入通信设置模块的阳光云子模块，开启通信总开关以接入阳光云功能，授权运维人员配置远程维护、接入阳光云功能。",
        "block_ids": [
          "BLK-95BE5E587B8C4342",
          "BLK-246DEBE9E6F8F66F"
        ],
        "is_uncertain": true
      }
    ],
