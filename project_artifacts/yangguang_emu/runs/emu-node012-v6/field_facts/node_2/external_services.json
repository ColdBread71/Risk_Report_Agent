    "field_id": "external_services",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元（EMU300A）可以直接通过路由器与阳光云平台连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-003",
        "statement": "远程访问（含阳光云数据转发）仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-004",
        "statement": "阳光云平台在北美区域禁止使用（或已停止服务）。",
        "block_ids": [
          "BLK-536C2D01D46C74B8",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器支持协议转换服务。",
        "block_ids": [
          "BLK-1AF38C7935ED3716"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "阳光云转发配置中，中国大陆地区默认接入“中国站”，欧洲地区接入“欧洲站”，澳洲地区接入“澳洲站”，其他地区接入“国际站”。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "转发三方云服务功能默认关闭；启用该功能前，客户需在充分知情的前提下使用管理员账号进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-008",
        "statement": "转发三方云功能仅在获得管理员账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-009",
        "statement": "云服务与外网有数据交互，开启前需确认设备网络环境安全。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "阳光云通信通道的启用需以administrator身份登录，进入通信设置模块的阳光云子模块，并开启通信总开关。",
        "block_ids": [
          "BLK-95BE5E587B8C4342",
          "BLK-246DEBE9E6F8F66F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "三方云功能的启用需以administrator身份登录，进入通信设置 > 三方云子页面，并开启三方云开关并完成确认授权。",
        "block_ids": [
          "BLK-84E2F121165CC7A2",
          "BLK-8C65146392F8991F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "FTP路径在三方云配置中按“/FTP服务器目录”方式命名，例如“/SUNGROW”中“/”表示根目录，“SUNGROW”为FTP服务器中存放数据的目录。",
        "block_ids": [
          "BLK-BC550FAF2948123A"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger4000是否作为本项目交付配置的一部分（GAP-LOGGER4000-SCOPE）",
      "阳光云平台的运营方是否为阳光电源股份有限公司（证据未明示主体）",
      "三方云服务所支持的具体第三方云平台列表（仅提及存在配置能力，未列明支持对象）",
      "安全加密认证所采用的具体协议或算法（如TLS版本、证书类型等）",
      "‘系统访问控制策略’的具体实现机制或策略来源（如基于角色、基于属性或外部IAM集成）",
      "阳光云与三方云服务是否共享同一套安全加密认证机制",
      "远程数据处理是否为产品功能所必需（即：若禁用所有云服务，EMU300A核心功能是否仍完整）"
    ],
    "contradictions": []
  },
