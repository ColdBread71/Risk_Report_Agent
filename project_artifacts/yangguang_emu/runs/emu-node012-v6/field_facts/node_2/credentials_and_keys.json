    "field_id": "credentials_and_keys",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "阳光电源设备在生产阶段预置阳光电源证书，该证书是设备出厂必备的身份凭证。",
        "block_ids": [
          "BLK-12BF8540AA500417"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "阳光电源预置证书仅用于部署阶段为设备接入客户网络建立初始安全通道，阳光电源不对预置证书的安全性做承诺与保证。",
        "block_ids": [
          "BLK-46C00A4E0F6A683B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "对于预置证书作为业务使用的场景，阳光电源不对其安全性做出承诺与保证，建议用户更换使用自己的安全证书。",
        "block_ids": [
          "BLK-B775CA8B855D40B9"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "设备出厂自带默认PKI颁发的证书，建议导入客户的签名证书。",
        "block_ids": [
          "BLK-36828A2B13F690DE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "若使用NTS功能，客户需导入NTS服务器证书；NTS证书从NTS服务器获取，支持PEM格式的X.509证书导入。",
        "block_ids": [
          "BLK-1294EA0594DF6992"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "在证书管理页面，点击goose密钥，选择密钥导入，上传密钥文件即可完成密钥更新。",
        "block_ids": [
          "BLK-90A3EAF30CD1A413"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "当证书距离过期时间不足90天时，系统触发“即将过期”告警。",
        "block_ids": [
          "BLK-731B6EE8DB6B37A6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "用户登录成功后，对于证书即将过期或已过期，系统将提示，并将结果记录至syslog日志。",
        "block_ids": [
          "BLK-0C005846289156C7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "重置普通用户、运维用户、审计用户账号的功能存在。",
        "block_ids": [
          "BLK-61275F681ECF4D1E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "若管理员账户忘记登录密码，可通过将校验码与设备SN号发送至SUNGROW运维，再输入SUNGROW运维返回的密钥，重置密码。",
        "block_ids": [
          "BLK-70F40B0CCFC973A7",
          "BLK-4384E460893C3259"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "通过系统 > 证书管理 > 采集/转发/NTS对时证书，支持导入证书。",
        "block_ids": [
          "BLK-76BE0FA03440A031"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "在证书管理页面，点击转发，单击新增，选择上传证书名称、协议及端口，可完成服务端证书导入。",
        "block_ids": [
          "BLK-A7E85922A01F094C"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "是否所有EMUs均预置阳光电源证书，或其预置状态取决于合同/BOM/现场配置？",
      "‘默认PKI颁发的证书’具体指哪家PKI机构？是否为阳光电源自建PKI？",
      "NTS服务器证书是否必须由特定NTS服务器提供，还是支持任意兼容NTS服务器？",
      "goose密钥更新所用密钥文件格式（如PEM/PKCS#8）、算法要求、密钥长度等未说明。",
      "校验码生成机制、有效期、传输方式（如邮件/短信/API）未说明。",
      "SUNGROW运维响应时效、密钥分发通道安全性、密钥有效期等运营细节未说明。",
      "是否存在设备唯一标识（如SN）以外的其他硬编码凭据（如默认API令牌、调试密钥）？",
      "是否存在出厂默认账号密码？手册未提及默认凭据，但未明确声明不存在。",
      "防重放功能中‘检测时间参数’是否涉及密钥派生或会话密钥管理？未说明。",
      "GAP-LOGGER4000-SCOPE指出Logger4000适用性待确认，其证书与密钥管理是否独立于EMU300A主系统？"
    ],
    "contradictions": []
  },
