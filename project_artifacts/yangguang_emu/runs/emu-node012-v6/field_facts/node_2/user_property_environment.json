    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "手册明确将“财产损失”列为未遵循安全说明可能导致的后果之一。",
        "block_ids": [
          "BLK-E3C1223513258C5B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "手册指出忽视硬件文档中的安全说明和遗留风险可引发生命危险，导致重伤或死亡。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "工业网络安全保护目标包括防范网络攻击危及人员安全与生产安全。",
        "block_ids": [
          "BLK-D91D8C5D38EFEB46"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "工业网络安全保护目标包括防止工业自动化系统及其组件被非法访问、操纵或者数据丢失。",
        "block_ids": [
          "BLK-DB3FDECA1B79E396"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "工业网络安全保护目标包括防止工业通信信息被窃取和操纵。",
        "block_ids": [
          "BLK-F365C432A5D0C66E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "工业网络安全保护目标包括防止机密数据遭受未经授权的访问。",
        "block_ids": [
          "BLK-5D9BB1795ED1309B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "实施安全措施时需确保其不会干扰或危及自动化系统以及组件的可操作性。",
        "block_ids": [
          "BLK-2BC99C167CF3B5F3"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "企业物理安全存在漏洞时，未经授权的人员可能进入生产环境，损坏或修改生产设备，导致机密信息丢失。",
        "block_ids": [
          "BLK-AF5815D0F7E277A5",
          "BLK-BDEC2C4D8C8E8B36"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "应对关键生产区域进行单独的人员出入控制。",
        "block_ids": [
          "BLK-C65542BD825C9290"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "重要组件应安装在可上锁的控制柜/控制室内。",
        "block_ids": [
          "BLK-F98DE46C72A1F829"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "产品北向属于安全重点关注区域，用户网络环境应在北向数据出口部署防火墙、防恶意代码设备、IDS等安全设备。",
        "block_ids": [
          "BLK-B6469A1F85E312C7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "产品南向属于近端网络部署，网络环境相对安全，但并非绝对安全；该表述为建议性内容，未指定具体防护措施。",
        "block_ids": [
          "BLK-AFA75AA365265142"
        ],
        "is_uncertain": true
      }
    ],
    "unknowns": [
      "手册未明确定义‘生产安全’的具体内涵（如是否涵盖设备安全、工艺安全、功能安全等子维度）",
      "手册未说明‘人员出入控制’的具体实现方式（如门禁类型、权限分级、审计要求）",
      "手册未说明‘可上锁的控制柜/控制室’的锁具等级、防破坏标准或认证依据",
      "手册未界定‘北向数据出口’所指的具体通信协议、接口或数据流向边界",
      "手册未说明防火墙、防恶意代码设备、IDS等安全设备的部署位置（如DMZ内/外）、配置基线或合规要求",
      "手册未说明南向网络‘相对安全’的判定依据（如物理隔离程度、访问控制机制、已知威胁暴露面）",
      "手册未提及对环境（如电磁、温湿度、粉尘）、公共利益、业务连续性、生产运行等其他user_property_environment维度的直接保护目标或缓解措施"
    ],
    "contradictions": []
  },
