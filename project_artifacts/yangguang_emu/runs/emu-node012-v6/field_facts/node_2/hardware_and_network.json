    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 设备提供 RS232 协议的 Debug 口，用于串口访问 Linux 系统。",
        "block_ids": [
          "BLK-5751A158B27985D4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 支持通过网口向阳光云发送 MQTT 消息，目标端口为 19999，使用公钥认证、无加密方式，该功能默认关闭，开启时给予安全提示。",
        "block_ids": [
          "BLK-5751A158B27985D4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A 支持通过网口向阳光云发送 MQTT 消息，目标端口为 16668，使用公钥认证、TLS 加密方式，该功能默认关闭，开启时给予安全提示。",
        "block_ids": [
          "BLK-5751A158B27985D4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "EMU300A 支持通过网口向 NTP 对时服务器发送 NTP 请求，目标端口为 123，无需认证与加密，该功能默认关闭，开启时给予安全提示。",
        "block_ids": [
          "BLK-5751A158B27985D4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "MOXA EDS-408A 交换机支持通过 Console 串口连接，CLI 密码更新操作需在波特率 115200 下进行。",
        "block_ids": [
          "BLK-41C649321EC9FCF3",
          "BLK-50F7C65843B01D86"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "MOXA EDS-408A 交换机支持通过 Web 管理界面关闭非必要管理接口（Basic Setting > Security > Management Interface）。",
        "block_ids": [
          "BLK-36FB0A68AF75FE85"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "MOXA EDS-408A 交换机在取消管理接口后，仍可通过 Console 串口进行登录管理。",
        "block_ids": [
          "BLK-EDC5C2184DE9105D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "MOXA EDS-408A 交换机支持 VLAN 配置，可在 'Virtual LAN' → 'VLAN Settings' 中设置 Management VLAN ID 并激活。",
        "block_ids": [
          "BLK-9A30F47EBE526FFD"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "MOXA EDS-408A 交换机可将物理接口划分为业务接口与管理接口；若未预留管理接口，仍可通过 Console 串口进行登录管理。",
        "block_ids": [
          "BLK-29C1D2687B061739"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "MOXA EDS-408A 交换机支持通过笔记本网口连接端口 1，使用 HTTPS 访问其 Web 配置界面以执行固件升级。",
        "block_ids": [
          "BLK-EBC2AAA9362F3A94"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "MOXA EDS-408A 交换机支持通过笔记本网口连接端口 1，使用 HTTPS 访问其 Web 配置界面以执行配置导入和备份。",
        "block_ids": [
          "BLK-C197FC251B6DDDDA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "MOXA EDS-408A 交换机支持通过 CLI 执行 'save config' 命令保存配置。",
        "block_ids": [
          "BLK-63CBCE78F86EB9D5"
        ],
        "is_uncertain": false
      }
