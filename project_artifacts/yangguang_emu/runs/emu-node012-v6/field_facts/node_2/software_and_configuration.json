  "result": {
    "node_id": "node_2",
    "field_id": "software_and_configuration",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "安全启动（Secure Boot）是一种基于逐级验证的启动链可信加载技术，用于确保系统固件与操作系统镜像的完整性与合法性，防止其被非法篡改或替换。",
        "block_ids": [
          "BLK-11E7630FDD454CE8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "在本产品中，安全启动功能默认处于启用状态。",
        "block_ids": [
          "BLK-56710D21D4166A27"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "本节所述安全启动仅针对数采。",
        "block_ids": [
          "BLK-696CBA8087AAE64A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "固件升级提供关键的安全更新和性能优化，是确保设备稳定、安全和高效运行的关键措施。",
        "block_ids": [
          "BLK-DC02C8FBAB3CFB88"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "用户可通过Web端升级阳光电源逆变器、数据采集器和PLC节点。",
        "block_ids": [
          "BLK-DC02C8FBAB3CFB88"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "Web端先检测数据采集器同一局域网下是否安装iConfig工具；如已安装iConfig并下载可用升级包，Web端展示与当前设备匹配的升级包。",
        "block_ids": [
          "BLK-9BE7D0EB955D7982"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "支持通过配置工具iConfig升级数据采集器。",
        "block_ids": [
          "BLK-5DC9B72C577D320F",
          "BLK-E42FAA2B91DEAFA6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "支持通过阳光云升级数据采集器。",
        "block_ids": [
          "BLK-6526B1BEA655A990",
          "BLK-A8F30CB0E2DE9C4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "通过远程维护登录数据采集器时，不支持通过配置工具iConfig升级方式进行升级。",
        "block_ids": [
          "BLK-B365C6DDD636B615"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "升级数据采集器时，若弹窗提示缺少公钥文件，需通过系统 > 系统维护 > 公钥导入导入升级包对应的公钥文件，再进行升级操作。",
        "block_ids": [
          "BLK-56AA86C794BB112B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "Web端将弹窗提示是否确认升级，确认后数据采集器自动重启；新版本在重启后生效。",
        "block_ids": [
          "BLK-AA1F4A66BBA10E2B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "通过阳光云升级需已接入云服务且当前有可用升级包；相关设置见7.10.6.1 转发阳光云服务设置。",
        "block_ids": [
          "BLK-86DACA655BC61901",
          "BLK-A8F30CB0E2DE9C4D",
          "BLK-4990168AEBD8747F"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger4000是否为本产品实际交付配置中的组件（GAP-LOGGER4000-SCOPE）",
      "安全启动是否覆盖除数采外的其他组件（如逆变器、PLC）",
      "iConfig工具是否为产品标准内置组件，或仅为可选外部工具",
      "阳光云服务的运营方、数据主权归属及RDPS依赖关系未明确说明",
      "固件升级包的签名验证机制（如公钥来源、证书信任链）未在证据中描述",
      "eMMC中存储的系统镜像具体组成（如BootROM、BL2、U-Boot、内核、rootfs）未列出",
      "安全启动所依赖的根密钥（Root of Trust）是否固化于硬件（如eFuse/OTP）未说明",
      "是否存在禁用安全启动的配置方式或调试模式（证据仅提默认启用，未提可禁用性）"
    ],
    "contradictions": []
  },
