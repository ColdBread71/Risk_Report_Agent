    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "工业网络安全的核心目标包括可用性、保密性和完整性。",
        "block_ids": [
          "BLK-09BB4F761E6C697C",
          "BLK-32D86711ED1302DA",
          "BLK-D29A82FAFD09D484",
          "BLK-14EB48F1B4784375"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "工业网络安全保护目标之一是确保生产设备和流程的无故障运行和可用性。",
        "block_ids": [
          "BLK-F30391C2A61969FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "工业网络安全保护目标之一是防范网络攻击危及人员安全与生产安全。",
        "block_ids": [
          "BLK-D91D8C5D38EFEB46"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "工业网络安全保护目标之一是防止工业自动化系统及其组件被非法访问、操纵或者数据丢失。",
        "block_ids": [
          "BLK-DB3FDECA1B79E396"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "工业网络安全保护目标之一是防止工业通信信息被窃取和操纵。",
        "block_ids": [
          "BLK-F365C432A5D0C66E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "工业网络安全保护目标之一是防止机密数据遭受未经授权的访问。",
        "block_ids": [
          "BLK-5D9BB1795ED1309B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "工业网络安全以IEC 62443标准为参考。",
        "block_ids": [
          "BLK-32F06CE7CD351424"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "IEC 62443系列标准旨在为工业自动化系统（ICS系统）的安全运行提供支持，涵盖设计、实施及管理等方面。",
        "block_ids": [
          "BLK-5F6FAF6D64EBD1D8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "IEC 62443基于ISO 27001标准，ISO 27001主要包含各种IT安全规则。",
        "block_ids": [
          "BLK-6EACCBFBE9126A9C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "产品北向属于安全重点关注区域，用户网络环境应在北向数据出口部署防火墙、防恶意代码设备、IDS等安全设备，构建安全的北向安全网络。",
        "block_ids": [
          "BLK-B6469A1F85E312C7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "产品南向属于近端网络部署，网络环境相对安全，但并非绝对安全；建议南向和北向网络使用独立的交换机进行部署，实现网络隔离。",
        "block_ids": [
          "BLK-AFA75AA365265142",
          "BLK-AFED3332E2924093"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "南向设备对本产品来说属于三方设备，是否会对网络安全造成威胁由用户来保障。",
        "block_ids": [
          "BLK-EB131CDE5EBDAAA4"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "未明确说明EMU300A产品的物理部署环境（如温度、湿度、防护等级、安装方式等）",
