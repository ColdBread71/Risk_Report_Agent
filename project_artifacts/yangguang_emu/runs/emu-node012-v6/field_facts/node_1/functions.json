  "result": {
    "node_id": "node_1",
    "field_id": "functions",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元EMU300A内部配置有数据采集器Logger5000。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器Logger5000可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "数据采集器Logger5000通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "数据采集器Logger5000可通过PLC总线方式接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器Logger5000可对接入的逆变器进行有功功率控制和无功功率调节。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC",
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "数据采集器Logger5000可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发数据至综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "数据采集器Logger5000可接收北向远程调度指令或执行本地调度指令。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "数据采集器Logger5000可以将采集到的设备数据通过核心交换机传输至后台站控，例如Insight、SCADA。",
        "block_ids": [
          "BLK-153C2EE70C8A30F1",
          "BLK-182EE50E531ABD2E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "数据采集器Logger5000的数据转发功能默认不可用；启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-010",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-011",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "数据采集器Logger5000可以接受和执行来自电网的调度指令，包括远程调度控制指令、模拟量及数字量调度控制指令。",
        "block_ids": [
          "BLK-A0E52C3C63687B7D"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger4000是否为EMU300A实际交付配置（GAP-LOGGER4000-SCOPE）",
      "阳光云平台在澳洲、欧洲、国际等区域的具体服务可用性及合规性依据（仅知中国大陆接入‘中国站’、澳洲‘澳洲站’、欧洲‘欧洲站’、其他‘国际站’，但未说明是否全部可用）",
      "‘安全加密认证’所指的具体认证机制（如TLS版本、证书签发方、密钥管理方式）",
      "‘系统访问控制策略’的具体实现形式（如RBAC模型、策略引擎、审计粒度）",
      "路由器白名单设置参数的具体要求（仅提示需设置，未提供参数值或格式）",
      "时钟源设置为‘阳光云’的前提条件中‘与阳光云平台连接’是否依赖于已启用的数据转发功能（存在循环依赖风险）"
    ],
    "contradictions": []
  },
