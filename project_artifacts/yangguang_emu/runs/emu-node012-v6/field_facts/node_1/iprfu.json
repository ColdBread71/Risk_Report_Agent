  "result": {
    "node_id": "node_1",
    "field_id": "iprfu",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "未遵循安全说明和遗留风险可引发生命危险。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "忽视随附硬件文档中的安全说明和遗留风险会导致重伤或死亡。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "进行风险评估时应考虑遗留风险。",
        "block_ids": [
          "BLK-F4322E7C8FD3E6EB"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "对关键生产区域进行单独的人员出入控制是用户的缓解措施之一。",
        "block_ids": [
          "BLK-C65542BD825C9290"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "重要组件应安装在可上锁的控制柜/控制室内。",
        "block_ids": [
          "BLK-F98DE46C72A1F829"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "控制柜/控制室必须配备锁，并有监控和报警设施；不得使用结构简单的锁（如万能锁、三角锁、四角锁或双齿锁）。",
        "block_ids": [
          "BLK-B5B2DA70170FDE95"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "在安全删除产品之前，需参考第10章安全配置指南相关内容进行操作。",
        "block_ids": [
          "BLK-6F042AC19A0269C8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "当设备需要退役报废时，应参考10.6节恢复出厂设置章节操作，并通过安全渠道销毁、删除用户安全数据，确保设备不被二次部署或非法利用。",
        "block_ids": [
          "BLK-525B9314A5FDB5CB"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "产品报废场景包括：达到规定的使用年限；因严重损坏不具备使用条件；主要部件或结构损坏且无修复价值。",
        "block_ids": [
          "BLK-4D366B3D429D69D6",
          "BLK-9AE61B78288E5DE6",
          "BLK-D558E0F03D0C4DAC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "对于预置证书作为业务使用的场景，阳光电源不对其安全性做出承诺与保证，建议用户更换使用自己的安全证书。",
        "block_ids": [
          "BLK-B775CA8B855D40B9"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "阳光电源预置证书有效期为30年。",
        "block_ids": [
          "BLK-1F38C3E74276F886"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "当证书距离过期时间不足90天时，系统触发“即将过期”告警；当证书已过期时，系统触发“已过期”告警；告警结果记录至syslog日志。",
        "block_ids": [
          "BLK-0C005846289156C7",
          "BLK-731B6EE8DB6B37A6",
          "BLK-A1646F67D0B20DF6"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "未明确说明产品支持期限（如设计寿命、保修期、软件支持周期）的具体数值或判定依据。",
      "未说明‘遗留风险’在本产品上下文中的具体定义、来源或典型示例。",
      "未说明‘安全删除’所指的数据范围是否涵盖所有存储介质（如eMMC、TF卡、外部USB设备）及固件中嵌入的敏感信息。",
      "未说明恢复出厂设置是否彻底清除所有密钥、证书、用户配置及日志数据，或是否存在残留风险。",
      "未说明证书生命周期管理功能（如自动轮换、吊销检查）是否由产品内置实现，抑或完全依赖用户手动操作。",
      "未说明syslog日志的存储位置、保留时长、访问控制机制及是否支持远程传输。",
      "GAP-LOGGER4000-SCOPE：Logger4000是否属于EMU300A交付配置尚不确认，其相关IPRFU影响无法确定。",
      "GAP-CONTRACT-VARIANTS：手册中描述的用户缓解措施（如出入控制、锁具类型）是否为强制要求或仅属推荐性指导，未明确其合同约束力。",
      "未说明‘安全渠道销毁’的具体技术方式（如物理销毁、符合NIST SP 800-88标准的擦除）及责任主体（用户或供应商）。",
      "未说明第10章安全配置指南中所述操作是否适用于所有交付形态（如不同BOM版本、现场升级后状态）"
    ],
    "contradictions": []
  },
