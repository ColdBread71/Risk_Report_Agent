    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 系统组件包括支持 HTTPS、北向 IEC104、MODBUS 等协议的安全通信功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 支持 NTS 对时功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A 具备恢复出厂设置功能，可删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "EMU300A 具备操作日志和 syslog 记录功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A 支持软件和固件更新。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "Logger5000 数据采集器具备固件版本查看功能。",
        "block_ids": [
          "BLK-3D2AE51B14433CA1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "Logger5000 支持通过 Web 端升级阳光电源逆变器、数据采集器和 PLC 节点。",
        "block_ids": [
          "BLK-DC02C8FBAB3CFB88"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "Logger5000 Web 端升级方式依赖 iConfig 工具：需检测同一局域网下是否安装 iConfig，并下载匹配的升级包。",
        "block_ids": [
          "BLK-9BE7D0EB955D7982"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "Logger5000 不支持通过配置工具 iConfig 方式进行远程维护登录状态下的固件升级。",
        "block_ids": [
          "BLK-B365C6DDD636B615"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "Logger5000 固件升级需导入对应升级包的公钥文件（若弹窗提示缺少）。",
        "block_ids": [
          "BLK-56AA86C794BB112B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "Logger5000 固件升级完成后将自动重启，新版本在重启后生效。",
        "block_ids": [
          "BLK-AA1F4A66BBA10E2B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "MOXA EDS-408A 交换机固件版本可在浏览器界面最上方查看。",
        "block_ids": [
          "BLK-DCA16E70D082FCB6"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger4000 是否为 EMU300A 当前交付配置中的实际组件（GAP-LOGGER4000-SCOPE）",
      "EMU300A 内置操作系统、硬件模块、网络设备的具体型号与供应商信息未在证据中明确列出",
      "EMU300A 所用 TLS 协议具体版本、证书管理机制、恶意软件保护功能所依赖的具体组件（如反病毒引擎）未说明",
      "iConfig 工具是否为产品标准交付组件，或仅作为可选支持工具提供（GAP-CONTRACT-VARIANTS）",
      "‘设备列表’功能所管理的‘数据采集器所接入的设备’具体类型及协议支持范围未明确定义",
      "远程升级能力是否为产品功能所必需，或仅适用于特定合同/现场配置（GAP-CONTRACT-VARIANTS）"
    ],
