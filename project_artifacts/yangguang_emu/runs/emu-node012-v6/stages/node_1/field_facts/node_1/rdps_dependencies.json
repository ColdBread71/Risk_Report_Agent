    "field_id": "rdps_dependencies",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元（EMU300A）可以直接通过路由器与阳光云平台连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用；启用该功能需客户在充分知情前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-003",
        "statement": "远程访问（含阳光云数据转发）仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-004",
        "statement": "数据采集器具备将收集到的数据转发至综自系统、站控系统或阳光云平台的功能。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "阳光云平台在北美区域禁止使用（或已停止服务）。",
        "block_ids": [
          "BLK-536C2D01D46C74B8",
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "阳光云转发配置中，中国大陆地区默认接入“中国站”，欧洲地区接入“欧洲站”，澳洲地区接入“澳洲站”，其他地区接入“国际站”。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "为保证数据采集器功能正常使用，需对路由器白名单进行相关设置；设置参数请参考路由器白名单设置。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-008",
        "statement": "“转发三方云服务配置”用于配置数据采集器转发三方云服务；该功能默认关闭，启用前需管理员账号手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-0F6F7B781E8A2D1C"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-009",
        "statement": "三方云转发功能仅在获得管理员账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-0F6F7B781E8A2D1C"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-010",
        "statement": "接入阳光云功能需以administrator身份登录，点击通信设置模块进入阳光云子模块，并开启通信总开关。",
        "block_ids": [
          "BLK-95BE5E587B8C4342",
          "BLK-246DEBE9E6F8F66F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "三方云功能需以administrator身份登录，点击通讯设置 > 三方云，开启三方云开关并确认授权。",
        "block_ids": [
          "BLK-84E2F121165CC7A2",
          "BLK-8C65146392F8991F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "FTP路径在三方云配置中按“/FTP服务器目录”方式命名，例如“/SUNGROW”中“/”表示根目录，“SUNGROW”为FTP服务器中存放数据的目录。",
        "block_ids": [
          "BLK-BC550FAF2948123A"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "阳光云平台的运营方是否为产品制造商（阳光）自有云，或由第三方托管？",
      "‘安全加密认证’具体指何种认证机制（如TLS版本、证书类型、双向认证要求）？",
      "‘公共网络’是否特指互联网，或包含客户私有广域网（如MPLS）？",
      "‘系统访问控制策略’的具体实现层级（设备内置ACL、Web会话控制、还是依赖外部AAA系统）未说明。",
      "Logger4000是否参与RDPS依赖链？GAP-LOGGER4000-SCOPE明确其适用性待确认，故不纳入本字段事实。",
      "是否存在降级模式（如本地缓存+断网续传）支持RDPS功能？证据未提及。",
      "阳光云与三方云服务是否共享同一通信通道或隔离通道？证据未说明拓扑关系。",
      "‘时钟源设置为阳光云’的对时功能是否依赖RDPS连接持续可用？若连接中断，是否自动回退？"
    ],
    "contradictions": []
  },
