    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 能量管理单元可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "启用数据采集器向阳光云平台转发数据功能前，客户需在充分知情的前提下进行手动授权。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "启用数据采集器向阳光云平台转发数据功能需通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "远程访问仅在获得客户授权后方可生效。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "远程访问相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 的安全功能作为一个整体构成其纵深防御体系，在产品定义的安全上下文中提供对欺骗、篡改、否认、信息泄露、拒绝服务等威胁的保护。",
        "block_ids": [
          "BLK-916567FFECD7233D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 支持 HTTPS/北向 IEC104/MODBUS 等协议的 TLS 加密通信。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 支持 NTS 对时。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 具备恢复出厂设置功能，可删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A 具备操作日志、syslog 记录功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A 具备软件和固件更新功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "未明确说明阳光云平台的运营方是否为阳光公司自有，或是否依赖第三方云服务商。",
      "未明确说明数据上传至阳光云是否为产品功能所必需（即：是否存在离线/本地闭环运行模式）。",
      "未明确说明 Logger5000 是否为 EMU300A 标准内置数据采集器（仅提及‘标准内部 collector’，但未在 classification_inputs 证据中直接确认其型号与交付状态）。",
      "未明确说明‘恶意软件保护功能’是否为 EMU300A 内置安全功能，还是仅指用户侧建议部署的外部防恶意代码设备。",
      "未明确说明‘网络隔离’是否由 EMU300A 自身实现（如内置防火墙），还是仅建议用户侧部署外部防火墙。",
      "GAP-CONTRACT-VARIANTS 指出手册描述可选/合同依赖功能，但未列出本项目具体启用的功能清单。"
    ],
    "contradictions": []
