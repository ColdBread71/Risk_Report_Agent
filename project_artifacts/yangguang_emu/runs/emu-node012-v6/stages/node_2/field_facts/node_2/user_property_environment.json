    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "网络安全受损可能导致人员死亡或严重伤害。",
        "block_ids": [
          "BLK-0D5782B06D8B1BF9"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "网络安全受损可能导致人员中度或轻度伤害。",
        "block_ids": [
          "BLK-D55D028F74D15863"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "网络安全受损可能导致设备无法正常运行或造成财产损失。",
        "block_ids": [
          "BLK-E3C1223513258C5B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "未遵循安全说明和遗留风险可引发生命危险。",
        "block_ids": [
          "BLK-A8903F0B3105707C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "参数设置错误可导致机器出现故障，从而导致人员重伤或死亡。",
        "block_ids": [
          "BLK-1A706959C60B7DDA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "工业网络安全保护目标包括防范网络攻击危及人员安全与生产安全。",
        "block_ids": [
          "BLK-D91D8C5D38EFEB46"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "工业网络安全保护目标包括确保生产设备和流程的无故障运行和可用性。",
        "block_ids": [
          "BLK-F30391C2A61969FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "未经授权的人员进入生产环境可能损坏或修改生产设备，导致机密信息丢失。",
        "block_ids": [
          "BLK-AF5815D0F7E277A5"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "物理安全漏洞可能导致关键生产区域被非法访问，进而影响业务连续性。",
        "block_ids": [
          "BLK-AF5815D0F7E277A5",
          "BLK-BDEC2C4D8C8E8B36"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "对关键生产区域进行单独的人员出入控制是缓解措施之一。",
        "block_ids": [
          "BLK-C65542BD825C9290"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "重要组件安装在可上锁的控制柜/控制室内是缓解措施之一。",
        "block_ids": [
          "BLK-F98DE46C72A1F829"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "控制柜/控制室必须配备锁，并有监控和报警设施。",
        "block_ids": [
          "BLK-B5B2DA70170FDE95"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "管理员可通过删除可疑用户账号立即终止该用户的访问权限。",
        "block_ids": [
          "BLK-DBF11A90CC31126D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "管理员可通过修改用户密码应对用户密码泄露事件。",
        "block_ids": [
          "BLK-BDB4B6FD02F875A2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "管理员至多可创建4个运维账号（除“maintain”账号外）。",
        "block_ids": [
          "BLK-CE969232A195110E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "非必要请勿创建过多用户，以免多人抢占设备操作、用户密码泄露等。",
        "block_ids": [
          "BLK-CE969232A195110E"
        ],
        "is_uncertain": false
      }
    ],
