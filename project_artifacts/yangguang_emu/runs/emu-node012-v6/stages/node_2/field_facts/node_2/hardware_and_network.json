      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A 整机内部包含 IO 模组，该模块为可选配置。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A 整机内部包含风扇，该模块为标准内置组件。",
        "block_ids": [
          "BLK-B07115D81ED807D1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "EMU300A 整机内部包含 PID 模块，该模块支持 PID 防护和 PID 修复功能，适用于 PV-正偏置组件，并支持交流 ISO 检测功能。",
        "block_ids": [
          "BLK-D8AA6F0C8103713A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "EMU300A 整机内部包含 PLC 模块，该模块为标准内置组件。",
        "block_ids": [
          "BLK-D8AA6F0C8103713A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "EMU300A 整机配备 RS485 通讯端子，线缆规格要求为 2 × (0.75~1.5) mm² 户外型防紫外线带屏蔽层双绞线，线缆未包含在供货范围内。",
        "block_ids": [
          "BLK-D8AA6F0C8103713A",
          "BLK-C1BA5ECEEBD08A94"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "EMU300A 整机配备 4 路 RS485 接口。",
        "block_ids": [
          "BLK-B33119997D4D8B57"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "EMU300A 整机配备 5 路以太网口（ETH），均为 10/100 Mbps，其中 ETH1/2/5 为以太网口，ETH3/4 为快速调度口，ETH5 为调试口。",
        "block_ids": [
          "BLK-B33119997D4D8B57",
          "BLK-276B765BAAD65005"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "EMU300A 整机配备 MPLC 通信接口，数量为 1 或 2 个，可选。",
        "block_ids": [
          "BLK-B33119997D4D8B57"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "EMU300A 整机配备光纤环网交换机，该设备为选配，必须与光纤终端盒配套使用。",
        "block_ids": [
          "BLK-D8AA6F0C8103713A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "EMU300A 整机配备光纤终端盒，该设备为选配，必须与光纤环网交换机配套使用。",
        "block_ids": [
          "BLK-D8AA6F0C8103713A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "Logger5000 数据采集器集成五路具备数据交换功能的以太网口（ETH1~ETH5），其中三路为以太网口、两路为快速调度口。",
        "block_ids": [
          "BLK-276B765BAAD65005"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "Logger5000 数据采集器配备 Micro SD 卡接口，该端口仅阳光电源技术人员可用，用于设备软件烧写。",
        "block_ids": [
          "BLK-620E54D88F061730"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-021",
        "statement": "Logger5000 数据采集器配备 IRIG-B B 码对时接口。",
        "block_ids": [
          "BLK-620E54D88F061730"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-022",
        "statement": "Logger5000 数据采集器配备 9 路 RS485 通信接口（A1B1~A9B9），支持接入从站设备或后台系统。",
        "block_ids": [
          "BLK-620E54D88F061730"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-023",
        "statement": "Logger5000 数据采集器配备数字量输入端口（DI1~DI4）和数字量输出端口（DO1~DO4），其中 DO1~DO4 为继电器输出接口（24Vdc/3A）。",
        "block_ids": [
          "BLK-620E54D88F061730",
          "BLK-53B1B184B909BD96"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-024",
        "statement": "Logger5000 数据采集器配备模拟量输入端口（AI1~AI2），其中 AI1 支持 0~10Vdc，AI2 支持 4~20mA。",
        "block_ids": [
          "BLK-620E54D88F061730"
        ],
        "is_uncertain": false
      }
