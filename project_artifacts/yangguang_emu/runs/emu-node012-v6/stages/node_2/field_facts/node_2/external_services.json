    "field_id": "external_services",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元（EMU300A）可通过路由器连接至阳光云平台。",
        "block_ids": [
          "BLK-853407424F1C1351",
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器（Logger5000）具备将收集到的数据转发至阳光云平台的功能。",
        "block_ids": [
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用；启用前需客户手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF",
          "BLK-ABD8EE23CFEA3B93"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "能量管理单元可通过4G路由器将采集到的设备数据直接传输至阳光云。",
        "block_ids": [
          "BLK-64FE47677390A3C6"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "阳光云平台在北美区域已停止服务。",
        "block_ids": [
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "阳光云服务时钟源设置为“阳光云”时，前提是数据采集器与阳光云平台连接；否则该对时方式无效。",
        "block_ids": [
          "BLK-89A6CAB539794403"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "阳光云站点按地区划分：中国大陆地区接入“中国站”，欧洲地区接入“欧洲站”，澳洲地区接入“澳洲站”，其他地区接入“国际站”。",
        "block_ids": [
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "转发三方云服务配置功能用于配置数据采集器向第三方云服务转发数据。",
        "block_ids": [
          "BLK-0F6F7B781E8A2D1C"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "转发三方云功能默认关闭；启用前需管理员账号手动授权，并通过安全加密认证接入公共网络；仅在获得管理员账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "云服务与外网有数据交互，开启前需确认设备网络环境安全。",
        "block_ids": [
          "BLK-AD1E6A7FA18DAC21",
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "远程维护功能默认关闭；启用前需使用administrator账号手动授权，并通过安全加密认证接入公共网络；仅在获得administrator账号授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-E8D208159F329BFA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "Syslog日志可配置为上传至远程服务器，需设置Syslog服务IP地址。",
        "block_ids": [
          "BLK-A3BA38611AC0C157"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "Syslog配置支持设置远程服务器IP、端口和日志等级。",
        "block_ids": [
          "BLK-1B770EBE1946B023"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "阳光云通信通道由通信总开关控制；开启该开关则启用阳光云通信通道，并授权运维人员配置远程维护、接入阳光云功能。",
        "block_ids": [
          "BLK-246DEBE9E6F8F66F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "三方云开关开启后，允许设备数据上传到配置的服务器。",
        "block_ids": [
          "BLK-8C65146392F8991F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "阳光云转发配置可通过Web界面“系统 > 转发配置”中修改。",
        "block_ids": [
          "BLK-7CA94C17A4F80A13"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "三方云配置需以administrator身份登录，在“通信设置 > 三方云”子页面中进行。",
        "block_ids": [
          "BLK-84E2F121165CC7A2"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "阳光云平台的运营方是否为阳光公司或其指定第三方？",
      "三方云服务所指的具体平台名称、协议、认证机制及数据范围未说明。",
      "远程升级功能是否存在、是否属于本产品能力、是否依赖阳光云或三方云未被证据提及。",
      "时间服务（除阳光云作为时钟源外）是否独立提供NTP/PTP等外部时间源接入能力未明确。",
      "目录服务、文件服务、上级系统、管理系统等其他外部服务类型未在证据中出现。",
      "断网情况下阳光云或三方云服务的降级行为未说明。",
      "‘安全加密认证’所指具体协议（如TLS版本、证书要求）和认证流程未定义。",
      "‘系统访问控制策略’的具体实现机制、粒度（用户/角色/IP/功能）未说明。"
    ],
    "contradictions": []
  },
