    "field_id": "credentials_and_keys",
    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "Web 用户类型包括普通用户（username: user）、运维用户（username: maintain）、审计用户（username: auditor）、管理员（username: administrator）和开发者用户（username: develop）。",
        "block_ids": [
          "BLK-4417EC6A57B44907",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "普通用户、运维用户、审计用户、管理员的默认密码由“用户名”与“设备序列号（SN）”拼接而成；例如，若设备SN为“SN12345678”，用户名为“user”，则对应默认密码为“userSN12345678”。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "开发者用户的密码采用动态生成机制，通过客户授权获得设备SN，生成对应的动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-1429A3505D4AB3AA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-004",
        "statement": "操作系统用户包含 root 用户，其默认密码根据客户授权获取SN生成动态密码。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-B69166A4A2ED2877"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-005",
        "statement": "管理员账号可创建用户账号、重置账号密码、设置账户保护和会话安全参数、启用研发调试开关。",
        "block_ids": [
          "BLK-17E66B8FE1AEAB17"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "管理员可通过登录自身账户删除其他用户，立即终止该用户的访问权限。",
        "block_ids": [
          "BLK-DBF11A90CC31126D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "管理员可通过登录自身账户修改其他用户密码。",
        "block_ids": [
          "BLK-BDB4B6FD02F875A2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "所有用户的密码都具备有效期，密码有效期范围为1~90天，可通过管理员账户自行设置。",
        "block_ids": [
          "BLK-62C710106569541C",
          "BLK-A4723AAA2B990E87"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "新增用户时，用户名需由2–16位字母、数字组成，且必须以字母开头。",
        "block_ids": [
          "BLK-81634645B7FDAF2B"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "管理员至多可创建4个运维账号（除“maintain”账号外）。",
        "block_ids": [
          "BLK-CE969232A195110E"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "重置普通用户、运维用户、审计用户账号需通过管理员账号登录Web端后，在用户管理页面点击对应操作栏中的修改按钮。",
        "block_ids": [
          "BLK-61275F681ECF4D1E",
          "BLK-4426BD4984D9B293",
          "BLK-929758496B500C47",
          "BLK-E1BD1B41E544127F"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "重置管理员账号密码需在Web端输入administrator账号后点击‘忘记密码’，将校验码与设备SN号发送至SUNGROW运维，再输入SUNGROW运维返回的密钥方可完成。",
        "block_ids": [
          "BLK-292B9CD931E909F1",
          "BLK-70B36BD10F8E960B",
          "BLK-1B5CDD7127691343",
          "BLK-F21A6FC7F4B2A958"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "系统升级时可能需要导入升级包文件对应的公钥（.pem格式），以完成数字签名校验流程。",
        "block_ids": [
          "BLK-F9A4F9723511D487",
          "BLK-14719D4D62193798"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-014",
        "statement": "公钥导入功能位于Web界面：系统 > 系统维护 > 公钥导入。",
        "block_ids": [
          "BLK-5B4421727B6BF311",
          "BLK-25EC72F7D907113E",
          "BLK-35A4A8029CBCFB09"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "Web用户凭据支持分配用户登录证书。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "设备标识（SN）参与默认密码生成，且用于管理员重置密码流程中的校验码关联。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-2663D9583766CD4D",
          "BLK-70F40B0CCFC973A7"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "用户登录证书由管理员分配，但证据未说明其格式、算法、有效期或存储位置。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-018",
        "statement": "存在远程维护访问机制：管理员重置administrator密码需向SUNGROW运维提交校验码与设备SN，并接收其返回的密钥。",
        "block_ids": [
          "BLK-70F40B0CCFC973A7",
          "BLK-4384E460893C3259"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "Web界面提供密码有效期设置功能，但未说明是否强制启用或默认值。",
        "block_ids": [
          "BLK-62C710106569541C",
          "BLK-A4723AAA2B990E87"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-020",
        "statement": "存在开发者调试开关，由管理员启用，但证据未说明其访问方式、认证机制或启用条件。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA",
          "BLK-55CFEFE65B8FCCB4",
          "BLK-17E66B8FE1AEAB17"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-021",
        "statement": "日志或备份导出密码未在证据中提及。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-022",
        "statement": "协议密钥（如TLS/SSH密钥）未在证据中提及。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-023",
        "statement": "软件验签公钥（即升级公钥）以.pem格式文件形式被导入，但未说明其来源、颁发者、信任链或更新机制。",
        "block_ids": [
          "BLK-F9A4F9723511D487",
          "BLK-14719D4D62193798"
        ],
        "is_uncertain": true
      },
      {
        "fact_id": "FACT-024",
        "statement": "外部目录账号（如LDAP/AD）凭据未在证据中提及。",
        "block_ids": [
          "BLK-9E90596A86CAF9FA"
        ],
        "is_uncertain": true
      }
    ],
