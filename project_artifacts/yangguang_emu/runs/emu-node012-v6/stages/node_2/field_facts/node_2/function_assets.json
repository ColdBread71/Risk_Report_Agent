    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "数据采集器具备将收集到的数据转发至综自系统、站控系统或阳光云平台的功能。",
        "block_ids": [
          "BLK-DCE8A1FE2B86D398",
          "BLK-8CF56F6958CD33E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器的数据转发功能默认不可用。启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93",
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-003",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-ABD8EE23CFEA3B93",
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-004",
        "statement": "阳光云平台在北美区域禁止使用。",
        "block_ids": [
          "BLK-536C2D01D46C74B8"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-005",
        "statement": "数据采集器可以通过嵌入式Web界面，对系统时间、网络、串口等进行设置，对协议点表进行维护。",
        "block_ids": [
          "BLK-27076CE0D8D035A4"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-006",
        "statement": "数据采集器可以对接入的设备进行集中管理，包括参数配置、固件升级等，便于现场运维。",
        "block_ids": [
          "BLK-4229FA7FE6635AED"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-007",
        "statement": "数据采集器集成五路具备数据交换功能的以太网口（即ETH1~ETH5），三路以太网口，两路快速调度口。北向可以接入综自系统或站控系统，南向可以接入三方设备。",
        "block_ids": [
          "BLK-276B765BAAD65005"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-008",
        "statement": "数据采集器具备协议转换服务，包括ModbusRTU转IEC104、MQTT、ModbusTCP等。",
        "block_ids": [
          "BLK-915BE31950823B72"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-009",
        "statement": "数据采集器可以接受和执行来自电网的调度指令，包括远程调度控制指令、模拟量及数字量调度控制指令。",
        "block_ids": [
          "BLK-A0E52C3C63687B7D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-010",
        "statement": "数据采集器可以对接入的逆变器进行有功功率调节和无功功率调节。",
        "block_ids": [
          "BLK-275D81C277F1A9EC"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-011",
        "statement": "本手册中涉及的远程调度、有功功率调度和无功功率调度均代表上位机调度。",
        "block_ids": [
          "BLK-59B73DED760093DE"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-012",
        "statement": "安全启动功能默认处于启用状态。",
        "block_ids": [
          "BLK-56710D21D4166A27"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-013",
        "statement": "本产品中安全启动仅针对数采。",
        "block_ids": [
          "BLK-696CBA8087AAE64A"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-014",
        "statement": "Logger5000依托于芯片TrustZone及OP-TEE安全OS，对上层应用提供一套在安全环境下执行的加解密及存储数据接口，主要功能实现基于客户端应用（CA）对安全应用（TA）调用，实现安全环境下敏感数据进行加密存储，解密使用，包括用户密码，终端证书对应的私钥等数据。",
        "block_ids": [
          "BLK-402F20D08666D8CF"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-015",
        "statement": "若使用NTS功能，客户需导入NTS服务器证书。NTS证书从NTS服务器获取，支持PEM格式的X.509证书导入。",
        "block_ids": [
          "BLK-1294EA0594DF6992"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-016",
        "statement": "用户未导入第三方证书的情况下，服务端的HTTPS、IEC104、MODBUS证书使用默认转发证书。",
        "block_ids": [
          "BLK-DB79507AFAE893E1"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-017",
        "statement": "更新或删除HTTPS证书，需要重新建立链接，如遇网页无法正常打开，请重启浏览器。",
        "block_ids": [
          "BLK-7880DE869ED955AB"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-018",
        "statement": "管理员通过对不同的用户设置不同权限的账号，可以提高系统安全性、为不同的用户提升操作效率、降低管理成本。",
        "block_ids": [
          "BLK-3D831B5BDD0CBD81"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-019",
        "statement": "普通用户、运维用户、审计用户、管理员的密码由“用户名”与“设备序列号（SN）”拼接而成。",
        "block_ids": [
          "BLK-2663D9583766CD4D"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-020",
        "statement": "开发者用户的密码采用动态生成机制，通过客户授权获得设备SN，生成对应的动态密码。",
        "block_ids": [
          "BLK-1429A3505D4AB3AA"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-021",
        "statement": "通过阳光云升级：Web端展示阳光云上与当前设备匹配的线上升级包。",
        "block_ids": [
          "BLK-6526B1BEA655A990"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-022",
        "statement": "通过配置工具iConfig升级：通过远程维护登录数据采集器时，不支持通过配置工具iConfig升级方式进行升级。",
        "block_ids": [
          "BLK-B365C6DDD636B615"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-023",
        "statement": "支持NTS对时，建议采用NTS对时，以及定期更新证书。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      },
      {
        "fact_id": "FACT-024",
        "statement": "恢复出厂设置功能，删除设备数据。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false
      }
    ],
    "unknowns": [
      "Logger4000是否实际交付并启用（GAP-LOGGER4000-SCOPE）",
      "远程方案是否为产品功能所必需（RDPS依赖性未明确）",
      "HTTPS/IEC104/MODBUS等协议TLS加密通信是否为默认启用或仅属建议",
      "操作日志、syslog记录功能是否默认启用或需手动配置",
      "软件和固件更新是否支持自动下载与静默安装，或仅提供手动升级入口",
      "‘阳光云’运营方是否为阳光电源自身，或存在第三方云服务商参与",
      "eMMC中系统镜像被篡改的具体攻击面（如物理访问、远程漏洞利用等）未说明",
