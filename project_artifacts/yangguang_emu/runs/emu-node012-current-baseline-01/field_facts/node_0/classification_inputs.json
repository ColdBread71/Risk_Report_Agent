    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "能量管理单元可以直接通过路由器与阳光云连接。",
        "block_ids": [
          "BLK-1317C7BFFF509A67"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "数据采集器将数据转发至阳光云平台的功能默认不可用。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "启用该功能前，客户需在充分知情的前提下进行手动授权，并通过安全加密认证接入公共网络。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "远程访问仅在获得客户授权后方可生效，且相关操作受系统访问控制策略管理。",
        "block_ids": [
          "BLK-EBE329C3EFA80ACF"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "工业网络安全的核心目标是保障可用性、保密性和完整性。",
        "block_ids": [
          "BLK-09BB4F761E6C697C",
          "BLK-32D86711ED1302DA",
          "BLK-D29A82FAFD09D484",
          "BLK-14EB48F1B4784375"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A 产品的安全功能作为一个整体构成EMU300A 产品的纵深防御体系，在EMU300A 产品定义的安全上下文中，提供基础的包括欺骗、篡改、否认、信息泄露、拒绝服务等威胁的保护。",
        "block_ids": [
          "BLK-916567FFECD7233D"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "安全功能包括：HTTPS/北向IEC104/MODBUS/等协议TLS加密通信、支持NTS对时、恢复出厂配置功能、操作日志和syslog记录功能、软件和固件更新功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "建议采用TLS加密通信。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "建议采用NTS对时，以及定期更新证书。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "建议谨慎操作恢复出厂设置功能。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "建议定期分析安全日志。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "建议关注产品相关安全公告，及时升级到最新版本。",
        "block_ids": [
          "BLK-A31FF599B1E26CE2"
        ],
        "is_uncertain": true,
        "attributes": {}
      }
    ],
    "unknowns": [
