        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A可通过RS485总线方式接入光伏发电系统中的逆变器、箱变、环境监测仪、电表等设备。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A支持通过Modbus协议、PLC电力载波通信支持南向设备接入。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A可通过PLC总线方式接入阳光电源生产的具备PLC功能的组串式逆变器。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "EMU300A可对通过PLC总线接入的逆变器进行有功功率控制和无功功率调节。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "EMU300A可通过IEC104、Modbus、MQTT、GOOSE等通信协议北向转发数据到综自系统或站控系统及阳光云平台。",
        "block_ids": [
          "BLK-0FE6A5150E10C5BC"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
