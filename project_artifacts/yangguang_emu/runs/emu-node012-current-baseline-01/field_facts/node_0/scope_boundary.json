    "facts": [
      {
        "fact_id": "FACT-001",
        "statement": "EMU300A 能量管理单元可通过4G路由器将采集到的设备数据直接传输至阳光云。",
        "block_ids": [
          "BLK-58481F3BF8C8F982"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-002",
        "statement": "EMU300A 通过核心交换机连接至后台站控。",
        "block_ids": [
          "BLK-88F7F2D2F44E6545"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-003",
        "statement": "EMU300A 通过核心交换机连接至Insight或SCADA。",
        "block_ids": [
          "BLK-202781F4D7F5C1D3"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-004",
        "statement": "环形组网方式下，一个环网中最多可接入15台EMU300A。",
        "block_ids": [
          "BLK-A117B2CB2E7B47A8"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-005",
        "statement": "EMU300A 支持通过路由器连接至阳光云。",
        "block_ids": [
          "BLK-853407424F1C1351"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-006",
        "statement": "EMU300A 支持RS485、以太网、MPLC通信。",
        "block_ids": [
          "BLK-BC449CE85DB4F669"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-007",
        "statement": "EMU300A 支持跟踪系统、箱变测控、电表、环境监测仪等多种设备接入。",
        "block_ids": [
          "BLK-B081A00CB116A76B"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-008",
        "statement": "EMU300A 内含Logger5000（含电压电流采样接口）、开关电源、防雷模块、微型断路器、MPLC（可选1或2）、PID&ISO控制盒（可选）、光纤交换机（可选）、光纤终端盒（可选）、IO模组（可选）。",
        "block_ids": [
          "BLK-D844E7AC55AEA6FE"
        ],
        "is_uncertain": true,
        "attributes": {}
      },
      {
        "fact_id": "FACT-009",
        "statement": "光纤终端盒为选配，必须与光纤环网交换机配套使用。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-010",
        "statement": "光纤环网交换机为选配，必须与光纤终端盒配套使用。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-011",
        "statement": "RS485通讯端子线缆未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false,
        "attributes": {}
      },
      {
        "fact_id": "FACT-012",
        "statement": "交流熔丝盒线缆未包含在供货范围内。",
        "block_ids": [
          "BLK-AFC136CD8222B958"
        ],
        "is_uncertain": false,
